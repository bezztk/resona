<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Resona.Models"
             xmlns:views="clr-namespace:Resona.Views"
             x:Class="Resona.Views.MusicView">

    <UserControl.Styles>
        <Style Selector="Border.filter-surface TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style Selector="Border.filter-surface Button">
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Control}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent}"/>
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.shuffle-toggle">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.shuffle-toggle:pointerover">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.shuffle-toggle.active">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.shuffle-toggle.active:pointerover">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.toolbar-icon">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Control}"/>
            <Setter Property="Opacity" Value="0.86"/>
        </Style>
        <Style Selector="ToggleButton.toolbar-icon:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ToggleButton.toolbar-icon:checked">
            <Setter Property="Background" Value="#343E6591"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ToggleButton.toolbar-icon /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Control}"/>
        </Style>
        <Style Selector="ToggleButton.toolbar-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.toolbar-icon:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#343E6591"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.bare-add">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.bare-add:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextStrong}"/>
        </Style>
        <Style Selector="Button.filter-sort">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#FF15171A"/>
            <Setter Property="BorderBrush" Value="#66707882"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.filter-sort:pointerover">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="#52FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
        </Style>
        <Style Selector="Button.filter-sort:pressed">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="BorderBrush" Value="#725F86AD"/>
        </Style>
        <Style Selector="Button.filter-sort-direction">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#FF15171A"/>
            <Setter Property="BorderBrush" Value="#66707882"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.filter-sort-direction:pointerover">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="#52FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
        </Style>
        <Style Selector="Button.filter-sort-option">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.filter-sort-option:pointerover">
            <Setter Property="Background" Value="#FF292C31"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#8A89919A"/>
        </Style>
        <Style Selector="Button.filter-sort-option.selected">
            <Setter Property="Background" Value="#FF222831"/>
            <Setter Property="BorderBrush" Value="#FF78A9E6"/>
            <Setter Property="Foreground" Value="#E7F1FB"/>
        </Style>
        <Style Selector="Button.preset-action">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Grid.preset-card-container:pointerover Button.preset-action">
            <Setter Property="Opacity" Value="0.72"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
        <Style Selector="Grid.preset-card-container:pointerover Button.preset-action:pointerover">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.completion-filter">
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Opacity" Value="0.58"/>
        </Style>
        <Style Selector="ToggleButton.completion-filter:pointerover">
            <Setter Property="Opacity" Value="0.86"/>
        </Style>
        <Style Selector="ToggleButton.completion-filter:checked">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ToggleButton.completion-filter.review:checked">
            <Setter Property="Background" Value="#24FFD27A"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Warning}"/>
        </Style>
        <Style Selector="ToggleButton.completion-filter.analysis:checked">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.DangerSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.DangerBorder}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Control}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.Input}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
        </Style>
        <Style Selector="TextBox.compact-search">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#46FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="4,0,4,1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Brush.AccentSurface}"/>
        </Style>
        <Style Selector="TextBox.compact-search:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#72FFFFFF"/>
        </Style>
        <Style Selector="TextBox.compact-search:focus">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#B8FFFFFF"/>
        </Style>
        <Style Selector="TextBox.compact-search /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#46FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="TextBox.compact-search:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#72FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="TextBox.compact-search:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#B8FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Accent}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
        </Style>
        <Style Selector="Slider.playback">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.AccentStrong}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
        </Style>
        <Style Selector="Slider.playback /template/ Thumb">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.AccentStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Slider.playback:pointerover /template/ Thumb">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Background" Value="#FAF9EF"/>
        </Style>
        <Style Selector="Slider.volume-vertical">
            <Setter Property="Width" Value="18"/>
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="Foreground" Value="#D9BFC8D2"/>
            <Setter Property="Background" Value="#4A737B85"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Slider.volume-vertical /template/ Thumb">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Background" Value="#FFF1F3F5"/>
            <Setter Property="BorderBrush" Value="#FF9FA8B2"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="#30362D"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem /template/ ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.track-card">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.track-card:pointerover">
            <Setter Property="Background" Value="#32262B22"/>
        </Style>
        <Style Selector="Border.selection-accent">
            <Setter Property="Background" Value="#FF78A9E6"/>
            <Setter Property="BoxShadow" Value="0 0 9 1 #8A78A9E6"/>
        </Style>
    </UserControl.Styles>

    <Panel x:Name="RootSurface">
    <Rectangle Fill="{DynamicResource Theme.Brush.Background}" IsHitTestVisible="False"/>
    <DockPanel LastChildFill="True">

        <!-- ── Toolbar ── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Theme.Brush.Navigation}"
                BorderBrush="#5B5444"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="2"
                            Height="30"
                            CornerRadius="1"
                            Background="Beige"/>
                    <Border x:Name="CollectionContextCoverBorder"
                            IsVisible="False"
                            Width="32" Height="32"
                            CornerRadius="7"
                            ClipToBounds="True"
                            Background="#2C2D29"
                            BorderBrush="#36FFFFFF"
                            BorderThickness="1">
                        <Image x:Name="CollectionContextCover" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="LibraryContextTitleText"
                                   Text="LIBRARY"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                   LetterSpacing="1.2"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="PlaylistSummaryText"
                                   Text=""
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#C8C1A9"
                                   Opacity="0.82"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    
                </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="9"
                        VerticalAlignment="Center">

                <TextBox x:Name="SearchBox"
                         Classes="compact-search"
                         Watermark="Search…"
                         IsVisible="False"
                         Width="230" Height="32"
                         VerticalContentAlignment="Center"
                         KeyDown="OnSearchBoxKeyDown"
                         LostFocus="OnSearchBoxLostFocus"/>
                
                <Button x:Name="SearchToggleBtn"
                        Classes="icon"
                        Click="OnSearchToggleClicked"
                        ToolTip.Tip="Search"
                        Opacity="0.86">
                    <Grid>
                        <Image x:Name="SearchIcon"
                               Source="{SvgImage /Assets/search.svg}"
                               Width="17" Height="17"/>
                        <Image x:Name="CloseSearchIcon"
                               Source="{SvgImage /Assets/close.svg}"
                               IsVisible="False"
                               Width="17" Height="17"/>
                    </Grid>
                </Button>

                <!-- Hidden state controls remain the source for built-in views and filtering. -->
                <ToggleButton x:Name="ShowNeedsReviewCheckBox"
                              IsVisible="False"
                              IsChecked="False"
                              Checked="OnCompletionFilterChanged"
                              Unchecked="OnCompletionFilterChanged"/>
                <Button x:Name="RefreshLibraryButton"
                        Click="OnRefreshLibraryClicked"
                        Classes="icon"
                        ToolTip.Tip="Refresh library"
                        IsVisible="False"
                        Opacity="0.86">
                    <Image Source="{SvgImage /Assets/reload.svg}" Width="17" Height="17"/>
                </Button>
                
                <Button Click="OnImportClicked"
                        Classes="icon"
                        ToolTip.Tip="Add Tracks"
                        Opacity="0.86">
                    <Image Source="{SvgImage /Assets/download.svg}" Width="17" Height="17"/>
                </Button>

                <Button Classes="icon"
                        Click="OnSettingsClicked"
                        Opacity="0.86"
                        ToolTip.Tip="Settings">
                    <Image Source="{SvgImage /Assets/gear.svg}" Width="17" Height="17"/>
                </Button>

                <Button x:Name="FiltersToggleBtn"
                        Classes="icon"
                        Click="OnToggleFiltersClicked"
                        ToolTip.Tip="Open filters"
                        VerticalContentAlignment="Center"
                        Opacity="0.86">
                    <Image Source="{SvgImage /Assets/filter.svg}"
                           Width="17" Height="17"/>
                </Button>

            </StackPanel>
            </Grid>
        </Border>

        <!-- ── Status / error text (hidden until needed) ── -->
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Top"
                   Text="" TextWrapping="Wrap"
                   IsVisible="False"
                   Height="0"/>

        <Border x:Name="CollectionOrderNotice"
                DockPanel.Dock="Top"
                IsVisible="False"
                Background="#EA20221F"
                BorderBrush="#3858B8A5"
                BorderThickness="0,0,0,1"
                Padding="20,7">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <TextBlock Text="Filtered collection view · reset the view to edit track order."
                           FontSize="10.5"
                           Foreground="#C9DCD6"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Reset view"
                        Click="OnResetCollectionViewClicked"
                        Padding="10,4"
                        FontSize="10"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Library and player occupy separate rows over one continuous artwork background. -->
        <Grid RowDefinitions="*,Auto">
            <Panel Grid.Row="0" ClipToBounds="True">

            <Image x:Name="LibraryArtworkBackground"
                   Margin="-42"
                   Stretch="UniformToFill"
                   Opacity="0.24"
                   IsVisible="False"
                   IsHitTestVisible="False">
                <Image.Effect>
                    <BlurEffect Radius="28"/>
                </Image.Effect>
            </Image>
            <Rectangle x:Name="LibraryArtworkScrim"
                       Fill="#660A0B0D"
                       IsVisible="False"
                       IsHitTestVisible="False"/>

            <ListBox x:Name="FileList"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Padding="6,8">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:TrackDisplayItem">
                        <Grid RowDefinitions="Auto,Auto"
                              MaxWidth="800"
                              HorizontalAlignment="Stretch">
                            <Border Grid.Row="0"
                                    Classes="track-card"
                                    PointerPressed="OnTrackContextMenuPointerPressed"
                                    Tapped="OnTrackCardTapped"
                                    DoubleTapped="OnTrackCardDoubleTapped"
                                    CornerRadius="0"
                                    ClipToBounds="True"
                                    MinHeight="54"
                                    Padding="0,0">
                                <Panel>
                                <Border IsVisible="{Binding IsPlaying}"
                                        CornerRadius="0"
                                        Background="#46191C20"
                                        BorderThickness="1"
                                        BorderBrush="#8A89919A"
                                        IsHitTestVisible="False">
                                </Border>
                                <Grid ColumnDefinitions="2,18,48,*"
                                      Height="54"
                                      VerticalAlignment="Top">

                                    <Grid Grid.Column="1"
                                          Width="18" Height="18"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="0,0,3,0"
                                          RenderTransform="translateX(3px)"
                                          IsHitTestVisible="False">
                                        <Grid.Effect>
                                            <DropShadowEffect OffsetX="0"
                                                              OffsetY="0"
                                                              BlurRadius="2"
                                                              Color="Black"
                                                              Opacity="0.9"/>
                                        </Grid.Effect>
                                        <Border Width="15" Height="24"
                                                Background="{Binding RatingBandForeground}"
                                                IsVisible="{Binding ShowRatingBandArrow}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                RenderTransformOrigin="50%,50%">
                                            <Border.OpacityMask>
                                                <ImageBrush Source="avares://Resona/Assets/rating-band-arrow.png"
                                                            Stretch="Uniform"/>
                                            </Border.OpacityMask>
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="{Binding RatingBandArrowRotation}"/>
                                            </Border.RenderTransform>
                                        </Border>
                                        <Ellipse Width="5.5" Height="5.5"
                                                 Fill="{Binding RatingBandForeground}"
                                                 IsVisible="{Binding ShowRatingBandDot}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- The local halo lets the cover bleed softly into its immediate surroundings. -->
                                    <Panel Grid.Column="2"
                                           Width="48" Height="54"
                                           Margin="-2,0,0,0"
                                           VerticalAlignment="Center">
                                        <Border Width="42" Height="42"
                                                CornerRadius="7"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#D0141512"
                                                BorderBrush="#46514D40"
                                                BorderThickness="0"
                                                Padding="1"
                                                BoxShadow="0 2 6 1 #88000000, 0 0 2 0 #52FFFFFF">
                                            <Border CornerRadius="5"
                                                    ClipToBounds="True"
                                                    Background="#292C25">
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                        </Border>
                                    </Panel>

                                    <!-- Two-line hierarchy: track identity, then source and classification. -->
                                    <Grid Grid.Column="3"
                                          Height="38"
                                          VerticalAlignment="Center"
                                          RowDefinitions="19,19"
                                          Margin="8,0,94,0"
                                          RowSpacing="0">
                                        <views:TrackTitleTagPanel Grid.Row="0"
                                                                  Gap="6"
                                                                  HorizontalAlignment="Stretch">
                                            <TextBlock
                                                       Text="{Binding Track.DisplayTitle}"
                                                       Foreground="{Binding TitleBrush}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <views:TrackTagSummaryControl Tags="{Binding TagDisplays}"
                                                                          Margin="0,0,8,0"
                                                                          HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center"/>
                                            <Border IsVisible="{Binding HasCollectionDisplay}"
                                                    Background="#2419B5A0"
                                                    BorderBrush="#6238C7B0"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="5,0"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="{Binding CollectionTooltip}">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="{Binding CollectionDisplayText}"
                                                               FontSize="9"
                                                               Foreground="#C7EEE7"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding CollectionOverflowText}"
                                                               FontSize="8.5"
                                                               Opacity="0.62"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </views:TrackTitleTagPanel>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding ChannelText}"
                                                       FontSize="10.5"
                                                       Opacity="0.7"
                                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                                       MaxWidth="180" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ChannelSeparatorText}"
                                                       FontSize="10" Opacity="0.38"
                                                       VerticalAlignment="Center"/>
                                            <views:TrackGenreSummaryControl Grid.Column="2"
                                                                            Genres="{Binding GenreDisplays}"
                                                                            HorizontalAlignment="Stretch"
                                                                            VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>

                                </Grid>
                                <StackPanel Width="72"
                                            Margin="0,0,7,0"
                                            Spacing="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <TextBlock Text="{Binding DownloadedDateText}"
                                               IsVisible="{Binding ShowDownloadedDate}"
                                               FontFamily="Consolas"
                                               FontSize="8.5"
                                               Foreground="{DynamicResource Theme.Brush.TextMuted}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>
                                    <TextBlock Text="{Binding DurationText}"
                                               Height="19"
                                               LineHeight="19"
                                               FontFamily="Consolas"
                                               FontSize="10"
                                               Foreground="#D7D0B8"
                                               Opacity="0.88"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>
                                    <TextBlock Text="{Binding RatingText}"
                                               Height="19"
                                               LineHeight="19"
                                               FontFamily="Segoe Print"
                                               FontSize="11.5"
                                               LetterSpacing="0.2"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Foreground="{Binding RatingForeground}">
                                        <TextBlock.Effect>
                                            <DropShadowEffect OffsetX="0"
                                                              OffsetY="0"
                                                              BlurRadius="1"
                                                              Color="Black"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>

                                <!-- <Border Classes="selection-accent" -->
                                <!--         IsVisible="{Binding IsPlaying}" -->
                                <!--         Width="3" -->
                                <!--         Height="34" -->
                                <!--         CornerRadius="2" -->
                                <!--         Margin="3,0,0,0" -->
                                <!--         HorizontalAlignment="Left" -->
                                <!--         VerticalAlignment="Center" -->
                                <!--         IsHitTestVisible="False"/> -->

                                </Panel>
                            </Border>
                            <Rectangle Grid.Row="1"
                                       Height="1"
                                       Margin="18,3">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0%,50%"
                                                         EndPoint="100%,50%">
                                        <GradientStop Color="#003C3930" Offset="0"/>
                                        <GradientStop Color="#FF3C3930" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Canvas x:Name="TrackPositionRail"
                    Width="16"
                    Margin="0,10,2,10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    ZIndex="8">
                <Button x:Name="PlayingTrackScrollMarker"
                        IsVisible="False"
                        Canvas.Left="0"
                        Width="16"
                        Height="20"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnPlayingTrackScrollMarkerClicked"
                        ToolTip.Tip="Scroll to playing track">
                    <Grid Width="14" Height="18">
                        <Rectangle Width="2"
                                   Height="18"
                                   HorizontalAlignment="Right"
                                   Fill="#FF78A9E6"/>
                        <Path Data="M 1 2 L 11 2 L 11 10 L 1 10 L 4 6 Z"
                              Fill="#FF78A9E6"
                              Stretch="None"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"/>
                    </Grid>
                </Button>
            </Canvas>
            </Panel>

            <!-- ── Player bar ── -->
            <Border x:Name="PlayerBar"
                    Grid.Row="1"
                    ZIndex="30"
                    Height="118"
                    Padding="0"
                    Background="Transparent"
                    ClipToBounds="False"
                    CornerRadius="0,0,0,0"
                    BorderBrush="#4A7C838B"
                    BorderThickness="0,1,0,0">
                <Border CornerRadius="0,0,0,0"
                        ClipToBounds="True"
                        Background="#F5111214">
                    <Panel>
                        <Grid Margin="16,8,16,10"
                              RowDefinitions="22,28,*"
                              RowSpacing="3">

                            <Border x:Name="UpcomingBar"
                                    Grid.Row="0"
                                    IsVisible="False"
                                    Padding="4,0,4,0">
                                <DockPanel>
                                    <TextBlock x:Name="CrossfadeStatusText"
                                               DockPanel.Dock="Right"
                                               IsVisible="False"
                                               FontSize="11" Opacity="0.4"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Next:"
                                                   FontSize="11" Opacity="0.4"/>
                                        <TextBlock x:Name="UpcomingTrackText"
                                                   FontSize="11" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Grid x:Name="PlaybackInfoPanel"
                                  Grid.Row="1"
                                  ColumnDefinitions="*,Auto"
                                  Height="28"
                                  IsVisible="False">
                                <Border Grid.Column="0"
                                        ClipToBounds="False">
                                    <Slider x:Name="PlaybackSlider"
                                            Classes="playback"
                                            Minimum="0" Maximum="100" Value="0"
                                            Margin="0,-5,0,0"
                                            VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="PlaybackTimeText"
                                           Grid.Column="1"
                                           Text="" FontSize="11" Opacity="0.55"
                                           Margin="10,0,0,0" MinWidth="86"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="2"
                                  ColumnDefinitions="Auto,*,Auto"
                                  Height="42">

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal" Spacing="2"
                                            VerticalAlignment="Center">
                                    <Button Classes="icon"
                                            Click="OnPreviousClicked"
                                            ToolTip.Tip="Previous track">
                                        <Image Source="{SvgImage /Assets/skip-back.svg}"
                                               Width="18" Height="18"/>
                                    </Button>
                                    <Button x:Name="PlayPauseBtn"
                                            Classes="icon"
                                            Click="OnPlayPauseClicked"
                                            ToolTip.Tip="Play / Pause">
                                        <Grid Width="26" Height="26">
                                            <Image x:Name="PlayIcon"
                                                   Source="{SvgImage /Assets/play.svg}"/>
                                            <Image x:Name="PauseIcon"
                                                   Source="{SvgImage /Assets/pause.svg}"
                                                   IsVisible="False"/>
                                        </Grid>
                                    </Button>
                                    <Button Classes="icon"
                                            Click="OnNextClicked"
                                            ToolTip.Tip="Next track">
                                        <Image Source="{SvgImage /Assets/skip-forward.svg}"
                                               Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           x:Name="NowPlayingText"
                                           Text=""
                                           Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                           Opacity="0.82"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="12,0,18,0"
                                           Padding="0,0,4,0"/>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal" Spacing="10"
                                            VerticalAlignment="Center">
                                    <Button x:Name="VolumeButton"
                                            Classes="icon">
                                        <Button.Flyout>
                                            <Flyout Placement="Top">
                                                <Flyout.FlyoutPresenterTheme>
                                                    <ControlTheme TargetType="FlyoutPresenter">
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="CornerRadius" Value="0"/>
                                                    </ControlTheme>
                                                </Flyout.FlyoutPresenterTheme>
                                                <Border Width="40"
                                                        Padding="5,9"
                                                        Background="#FF111317"
                                                        BorderBrush="#98737B85"
                                                        BorderThickness="1"
                                                        CornerRadius="2">
                                                    <Slider x:Name="VolumeSlider"
                                                            Classes="volume-vertical"
                                                            Orientation="Vertical"
                                                            Minimum="0" Maximum="100"
                                                            Value="100"
                                                            Width="18"
                                                            Height="118"
                                                            HorizontalAlignment="Center"
                                                            RenderTransform="translateX(-2px)"
                                                            PointerReleased="OnVolumeSliderPointerReleased"/>
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Image Source="{SvgImage /Assets/speaker.svg}"
                                               Width="18" Height="18"/>
                                    </Button>
                                    <Button x:Name="ShuffleBtn"
                                            Classes="icon shuffle-toggle"
                                            Click="OnShuffleToggleClicked">
                                        <Grid Width="17" Height="17">
                                            <Image x:Name="ShuffleMutedIcon"
                                                   Source="{SvgImage /Assets/shuffle.svg}"
                                                   Width="17" Height="17"
                                                   Opacity="0.26"/>
                                            <Image x:Name="ShuffleActiveIcon"
                                                   Source="{SvgImage /Assets/shuffle-active.svg}"
                                                   Width="17" Height="17"
                                                   IsVisible="False"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>

                            </Grid>
                        </Grid>
                    </Panel>
                </Border>
            </Border>

            <!-- ── Filter workspace overlay ── -->
            <Border x:Name="FilterDrawer"
                    Grid.Row="0"
                    ZIndex="40"
                    IsVisible="False"
                    Background="Transparent"
                    BorderThickness="0"
                    ClipToBounds="True">
                <Border x:Name="FilterSurface"
                        Classes="filter-surface"
                        Background="#F2121212"
                        BorderThickness="0,0,0,1"
                        BorderBrush="#14FFFFFF">
                <Grid RowDefinitions="Auto,*" Margin="30,22,30,26">
                    <Rectangle x:Name="FilterAtmosphereTint"
                               Grid.RowSpan="2"
                               Margin="-30,-22,-30,-26"
                               Opacity="0.12"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="100%,100%" EndPoint="15%,10%">
                                <GradientStop Color="#D0545FAF" Offset="0"/>
                                <GradientStop Color="#90734FA8" Offset="0.48"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Height="34" Margin="0,0,0,18">
                        <TextBlock Text="Filters" FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Click="OnToggleFiltersClicked"
                                Classes="icon"
                                Width="34"
                                Height="34"
                                Padding="0"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="Close filters"
                                Opacity="0.7">
                            <Image Source="{SvgImage /Assets/close.svg}"
                                   Width="16" Height="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="330,28,*">
                        <ScrollViewer Grid.Column="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="18" Margin="0,0,14,0">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="BUILT-IN VIEWS"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Opacity="0.42" LetterSpacing="1"/>
                                        <StackPanel x:Name="BuiltInPresetRows" Spacing="7"/>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{DynamicResource Theme.Brush.Divider}" Margin="0,5,0,0"/>

                                    <StackPanel Spacing="7">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="COLLECTIONS"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Opacity="0.42" LetterSpacing="1"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    x:Name="AddCollectionButton"
                                                    Classes="bare-add"
                                                    Click="OnAddCollectionClicked"
                                                    Width="28" Height="28" Padding="0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    ToolTip.Tip="Create collection">
                                                <TextBlock Text="+" FontSize="17" Margin="0,-2,0,0"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                        <StackPanel x:Name="CollectionRows" Spacing="7"/>
                                    </StackPanel>
                                </StackPanel>

                                <Rectangle Height="1" Fill="{DynamicResource Theme.Brush.Divider}"/>

                                <Grid ColumnDefinitions="*,42" ColumnSpacing="7">
                                    <Button x:Name="FilterSortButton" Classes="filter-sort">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Flyout.FlyoutPresenterTheme>
                                                    <ControlTheme TargetType="FlyoutPresenter">
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="CornerRadius" Value="0"/>
                                                    </ControlTheme>
                                                </Flyout.FlyoutPresenterTheme>
                                                <Border Width="267" Padding="3" Background="#FF151619"
                                                        BorderBrush="#8A656A72" BorderThickness="1" CornerRadius="2">
                                                    <StackPanel Spacing="0">
                                                        <TextBlock Text="SORT TRACKS BY"
                                                                   Margin="9,6,9,5"
                                                                   FontFamily="Consolas"
                                                                   FontSize="9" FontWeight="SemiBold"
                                                                   LetterSpacing="1" Opacity="0.55"/>
                                                        <Button x:Name="FilterSortNameOption" Classes="filter-sort-option selected"
                                                                Tag="0" Click="OnFilterSortOptionClicked">
                                                            <Grid ColumnDefinitions="18,*" ColumnSpacing="8">
                                                                <Image x:Name="FilterSortNameCheck" Source="{SvgImage /Assets/check.svg}"
                                                                       Width="12" Height="12" Opacity="0.9"/>
                                                                <TextBlock Grid.Column="1" Text="Name" FontSize="11.5"
                                                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                        <Button x:Name="FilterSortRatingOption" Classes="filter-sort-option"
                                                                Tag="1" Click="OnFilterSortOptionClicked">
                                                            <Grid ColumnDefinitions="18,*" ColumnSpacing="8">
                                                                <Image x:Name="FilterSortRatingCheck" Source="{SvgImage /Assets/check.svg}"
                                                                       Width="12" Height="12" Opacity="0"/>
                                                                <TextBlock Grid.Column="1" Text="Rating" FontSize="11.5" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                        <Button x:Name="FilterSortDownloadedOption" Classes="filter-sort-option"
                                                                Tag="2" Click="OnFilterSortOptionClicked">
                                                            <Grid ColumnDefinitions="18,*" ColumnSpacing="8">
                                                                <Image x:Name="FilterSortDownloadedCheck" Source="{SvgImage /Assets/check.svg}"
                                                                       Width="12" Height="12" Opacity="0"/>
                                                                <TextBlock Grid.Column="1" Text="Downloaded at" FontSize="11.5" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                        <Button x:Name="FilterSortDurationOption" Classes="filter-sort-option"
                                                                Tag="3" Click="OnFilterSortOptionClicked">
                                                            <Grid ColumnDefinitions="18,*" ColumnSpacing="8">
                                                                <Image x:Name="FilterSortDurationCheck" Source="{SvgImage /Assets/check.svg}"
                                                                       Width="12" Height="12" Opacity="0"/>
                                                                <TextBlock Grid.Column="1" Text="Duration" FontSize="11.5" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                        <Button x:Name="FilterSortCollectionOption" Classes="filter-sort-option"
                                                                IsVisible="False"
                                                                Tag="4" Click="OnFilterSortOptionClicked">
                                                            <Grid ColumnDefinitions="18,*" ColumnSpacing="8">
                                                                <Image x:Name="FilterSortCollectionCheck" Source="{SvgImage /Assets/check.svg}"
                                                                       Width="12" Height="12" Opacity="0"/>
                                                                <TextBlock Grid.Column="1" Text="Collection order" FontSize="11.5" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid ColumnDefinitions="*,14" ColumnSpacing="10">
                                            <StackPanel Spacing="0" VerticalAlignment="Center">
                                                <TextBlock Text="SORT BY" FontSize="8" FontWeight="SemiBold"
                                                           LetterSpacing="0.65" Opacity="0.42"/>
                                                <TextBlock x:Name="FilterSortText" Text="Name" FontSize="11.5"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Path Grid.Column="1" Width="10" Height="6"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M 1 1 L 5 5 L 9 1"
                                                  Stroke="{DynamicResource Theme.Brush.TextSecondary}"
                                                  StrokeThickness="1.5" StrokeLineCap="Round"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="SortDirectionButton"
                                            Grid.Column="1"
                                            Classes="filter-sort-direction"
                                            Content="↑"
                                            Click="OnSortDirectionClicked"
                                            ToolTip.Tip="Ascending"/>
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource Theme.Brush.Divider}"/>

                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,140" ColumnSpacing="8">
                                        <TextBlock Text="RATING"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Opacity="0.42" LetterSpacing="1"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1"
                                                Width="140" Height="26"
                                                Background="#FF15171A"
                                                BorderBrush="#66707882"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                ClipToBounds="True">
                                            <Grid ColumnDefinitions="69,69">
                                                <Border x:Name="RatingModeIndicator"
                                                        Grid.ColumnSpan="2"
                                                        Width="69"
                                                        Height="2"
                                                        VerticalAlignment="Bottom"
                                                        HorizontalAlignment="Left"
                                                        Background="#FF78A9E6"
                                                        CornerRadius="0"
                                                        IsHitTestVisible="False">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform>
                                                            <TranslateTransform.Transitions>
                                                                <Transitions>
                                                                    <DoubleTransition Property="X" Duration="0:0:0.16"/>
                                                                </Transitions>
                                                            </TranslateTransform.Transitions>
                                                        </TranslateTransform>
                                                    </Border.RenderTransform>
                                                </Border>
                                                <Border Grid.Column="0" Background="Transparent" Cursor="Hand"
                                                        PointerPressed="OnAllRatingsPressed">
                                                    <TextBlock x:Name="AllRatingsText" Text="All"
                                                               FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="1" Background="Transparent" Cursor="Hand"
                                                        PointerPressed="OnManualRatingsPressed">
                                                    <TextBlock x:Name="ManualRatingsText" Text="Manual"
                                                               FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <StackPanel x:Name="RatingButtonsPanel"
                                                IsVisible="False"
                                                Spacing="3"/>
                                </StackPanel>

                                <Rectangle Height="1" Fill="{DynamicResource Theme.Brush.Divider}"/>

                                <StackPanel Spacing="7">
                                    <TextBlock Text="APPLIED SETS"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Opacity="0.42"
                                               LetterSpacing="1"/>
                                    <StackPanel x:Name="FilterGroupsPanel" Spacing="8"/>
                                </StackPanel>

                                <Rectangle Height="1" Fill="{DynamicResource Theme.Brush.Divider}"/>

                                <StackPanel Spacing="7">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="YOUR PRESETS"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Opacity="0.5" LetterSpacing="1"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                x:Name="AddPresetButton"
                                                Classes="bare-add"
                                                Click="OnAddPresetClicked"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                ToolTip.Tip="Create preset">
                                            <TextBlock Text="+" FontSize="17" Margin="0,-2,0,0"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                    <StackPanel x:Name="PresetRows" Spacing="7"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Rectangle Grid.Column="1"
                                   Width="1"
                                   HorizontalAlignment="Center"
                                   Fill="#66757D86"/>

                        <DockPanel Grid.Column="2" LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Conditions" FontSize="14" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel DockPanel.Dock="Top"
                                            Spacing="9"
                                            Margin="0,0,0,14">
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                                            <TextBlock Text="Current set"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                Width="106" Height="24"
                                                Background="Transparent"
                                                ClipToBounds="True">
                                            <Grid ColumnDefinitions="52,52">
                                                <Border x:Name="ConditionModeIndicator"
                                                        Grid.ColumnSpan="2"
                                                        Width="38"
                                                        Height="2"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom"
                                                        Margin="7,0"
                                                        Background="{DynamicResource Theme.Brush.Success}"
                                                        CornerRadius="1"
                                                        IsHitTestVisible="False">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform>
                                                            <TranslateTransform.Transitions>
                                                                <Transitions>
                                                                    <DoubleTransition Property="X" Duration="0:0:0.16"/>
                                                                </Transitions>
                                                            </TranslateTransform.Transitions>
                                                        </TranslateTransform>
                                                    </Border.RenderTransform>
                                                </Border>
                                                <Border Grid.Column="0" Background="Transparent" Cursor="Hand"
                                                        PointerPressed="OnIncludeConditionPressed">
                                                    <TextBlock x:Name="IncludeConditionText" Text="Include"
                                                               FontSize="9.5" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="1" Background="Transparent" Cursor="Hand"
                                                        PointerPressed="OnExcludeConditionPressed">
                                                    <TextBlock x:Name="ExcludeConditionText" Text="Exclude"
                                                               FontSize="9.5" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            </Border>
                                            <Button x:Name="AddFilterGroupButton"
                                                    Grid.Column="2"
                                                    Click="OnAddFilterGroupClicked"
                                                    Width="26" Height="24"
                                                    Padding="0"
                                                    HorizontalAlignment="Right"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="0"
                                                    IsEnabled="False"
                                                    ToolTip.Tip="Add set">
                                                <TextBlock Text="+" FontSize="17" Margin="0,-2,0,0"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>

                                        <Rectangle Width="220" Height="1"
                                                   HorizontalAlignment="Left"
                                                   Fill="{DynamicResource Theme.Brush.Divider}"
                                                   Opacity="0.7"/>

                                        <TextBlock x:Name="CurrentSetEmptyText"
                                                   Text="Select genres, styles, tags, languages or emotional character ranges below."
                                                   FontSize="10.5"
                                                   Opacity="0.5"/>
                                        <StackPanel x:Name="CurrentSetGenresRow" IsVisible="False" Spacing="2">
                                            <TextBlock Text="GENRES" FontSize="9" FontWeight="SemiBold"
                                                       Opacity="0.42" LetterSpacing="0.8"/>
                                            <TextBlock x:Name="CurrentSetGenresText"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel x:Name="CurrentSetStylesRow" IsVisible="False" Spacing="2">
                                            <TextBlock Text="STYLES" FontSize="9" FontWeight="SemiBold"
                                                       Opacity="0.42" LetterSpacing="0.8"/>
                                            <TextBlock x:Name="CurrentSetStylesText"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel x:Name="CurrentSetTagsRow" IsVisible="False" Spacing="2">
                                            <TextBlock Text="TAGS" FontSize="9" FontWeight="SemiBold"
                                                       Opacity="0.42" LetterSpacing="0.8"/>
                                            <TextBlock x:Name="CurrentSetTagsText"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel x:Name="CurrentSetLanguagesRow" IsVisible="False" Spacing="2">
                                            <TextBlock Text="LANGUAGES" FontSize="9" FontWeight="SemiBold"
                                                       Opacity="0.42" LetterSpacing="0.8"/>
                                            <TextBlock x:Name="CurrentSetLanguagesText"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel x:Name="CurrentSetEmotionalRow" IsVisible="False" Spacing="2">
                                            <TextBlock Text="EMOTIONAL CHARACTER" FontSize="9" FontWeight="SemiBold"
                                                       Opacity="0.42" LetterSpacing="0.8"/>
                                            <TextBlock x:Name="CurrentSetEmotionalText"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                </StackPanel>

                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              Padding="0,0,14,0">
                                    <StackPanel x:Name="FilterBuilderPanel" Spacing="12"/>
                                </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Grid>
                </Border>
            </Border>

            <views:AddTrackOverlay x:Name="AddTrackOverlay" Grid.Row="0" IsVisible="False"/>

        </Grid>

    </DockPanel>


    <!-- Queue management is a workspace, not a small dialog. It deliberately stops above the player. -->
    <views:ImportOverlay x:Name="ImportOverlay" IsVisible="False" ZIndex="70"/>

    <!-- Covers the toolbar as well as the list while track details are open. -->
    <views:EditTrackOverlay x:Name="EditTrackOverlay" IsVisible="False" ZIndex="80"/>

    <views:SettingsOverlay x:Name="SettingsOverlay" IsVisible="False" ZIndex="90"/>

    <Border x:Name="DeleteTrackConfirmation"
            IsVisible="False"
            ZIndex="95"
            Background="#B8000000"
            Focusable="True"
            KeyDown="OnDeleteTrackConfirmationKeyDown">
        <Border Width="410"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Theme.Brush.Surface}"
                BorderBrush="{DynamicResource Theme.Brush.BorderStrong}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="22"
                BoxShadow="0 14 38 4 #88000000">
            <StackPanel Spacing="14">
                <TextBlock Text="Delete track?"
                           FontSize="17"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="DeleteTrackConfirmationText"
                           FontSize="12"
                           Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="9"
                            Margin="0,5,0,0">
                    <Button x:Name="CancelTrackDeleteButton"
                            Content="Cancel"
                            MinWidth="88"
                            Click="OnCancelTrackDeleteClicked"/>
                    <Button Content="Delete"
                            MinWidth="88"
                            Background="{DynamicResource Theme.Brush.DangerSurface}"
                            BorderBrush="{DynamicResource Theme.Brush.DangerBorder}"
                            Click="OnConfirmTrackDeleteClicked"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>


    <Border x:Name="Toast"
            IsVisible="False"
            ZIndex="100"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,104,0,0"
            Background="#E6101821"
            BorderBrush="{DynamicResource Theme.Brush.BorderStrong}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,9"
            BoxShadow="0 8 24 2 #66000000">
        <TextBlock x:Name="ToastText"
                   FontSize="12"
                   Foreground="#EAF3FA"/>
    </Border>

    </Panel>

</UserControl>
