<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Resona.Views.ImportOverlay"
             Background="#F2121212">
    <UserControl.Styles>
        <Style Selector="TextBox.compact-search">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#46FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="4,0,4,1"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Brush.AccentSurface}"/>
        </Style>
        <Style Selector="TextBox.compact-search:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#72FFFFFF"/>
        </Style>
        <Style Selector="TextBox.compact-search:focus">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#B8FFFFFF"/>
        </Style>
        <Style Selector="TextBox.compact-search /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#46FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="TextBox.compact-search:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#72FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="TextBox.compact-search:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#B8FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
    </UserControl.Styles>

    <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1">
    <Grid RowDefinitions="62,*">
        <Rectangle x:Name="ImportAtmosphereTint"
                   Grid.RowSpan="2"
                   Opacity="0.12"
                   IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="100%,100%" EndPoint="15%,10%">
                    <GradientStop Color="#D0545FAF" Offset="0"/>
                    <GradientStop Color="#90734FA8" Offset="0.48"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Border Grid.Row="0" Background="Transparent" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Import"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Click="OnCloseClicked" Classes="icon" ToolTip.Tip="Close queue" Opacity="0.7"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <Grid ColumnDefinitions="*,1,*" ColumnSpacing="22" Margin="26,22,26,32">
                <StackPanel Spacing="12">
                    <TextBlock Text="ADD LINKS" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" Opacity="0.45"/>
                    <TextBox x:Name="InputUrlBox"
                             Classes="compact-search"
                             Watermark="Paste a YouTube video or playlist link…"
                             Height="32"
                             VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                    <StackPanel Spacing="8" Margin="0,10,0,0">
                        <TextBlock Text="CHECKED LINKS" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" Opacity="0.45"/>
                        <TextBlock x:Name="EmptyPreviewText" Text="Paste a link above to check it automatically."
                                   FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                        <StackPanel x:Name="PendingPreviewRows" Spacing="8"/>
                    </StackPanel>
                </StackPanel>

                <Rectangle Grid.Column="1"
                           Width="1"
                           Fill="{DynamicResource Theme.Brush.Divider}"
                           VerticalAlignment="Stretch"/>

                <StackPanel Grid.Column="2" Spacing="12">
                    <TextBlock x:Name="QueueHeaderText" Text="CURRENT QUEUE" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" Opacity="0.45"/>
                    <TextBlock x:Name="EmptyQueueText" Text="Nothing is waiting yet." FontSize="12" Opacity="0.5"/>
                    <StackPanel x:Name="QueueSources" Spacing="10"/>
                    <TextBlock x:Name="AnalysisQueueHeaderText" Text="ANALYSIS QUEUE" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" Opacity="0.45" Margin="0,12,0,0"/>
                    <Border x:Name="AnalysisServerUnavailablePanel"
                            IsVisible="False"
                            Background="#341D1717"
                            BorderBrush="#7A4343"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock x:Name="AnalysisServerUnavailableText"
                                       Text="Server currently unavailable."
                                       FontSize="11"
                                       Foreground="#E8A0A0"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="RetryAnalysisServerButton"
                                    Grid.Column="1"
                                    Width="28"
                                    Height="26"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnRetryAnalysisServerClicked"
                                    ToolTip.Tip="Reconnect analysis server">
                                <Image Source="{SvgImage /Assets/reload.svg}" Width="14" Height="14" Opacity="0.82"/>
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="EmptyAnalysisQueueText" Text="No analysis pending." FontSize="12" Opacity="0.5"/>
                    <StackPanel x:Name="AnalysisQueueRows" Spacing="6"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
    </Border>
</UserControl>
