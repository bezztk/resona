<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Resona.Views"
             x:Class="Resona.Views.SettingsOverlay">

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="LetterSpacing" Value="0.12"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style Selector="ToggleButton">
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style Selector="ToggleButton.settings-nav">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ToggleButton.settings-nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
        </Style>
        <Style Selector="ToggleButton.settings-nav:checked">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceSelected}"/>
            <Setter Property="BorderBrush" Value="#FF78A9E6"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextStrong}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.settings-top-nav">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.settings-top-nav /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style Selector="Button.settings-top-nav:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
        </Style>
        <Style Selector="Button.settings-top-nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.settings-classification-option">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.settings-classification-option:pointerover">
            <Setter Property="Background" Value="#FF292C31"/>
            <Setter Property="BorderBrush" Value="#8A89919A"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
        </Style>
        <Style Selector="Button.settings-classification-option.selected">
            <Setter Property="Background" Value="#FF222831"/>
            <Setter Property="BorderBrush" Value="#FF78A9E6"/>
            <Setter Property="Foreground" Value="#E7F1FB"/>
        </Style>
        <Style Selector="TextBox.settings-input">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.Input}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.compact-search">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#46FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="4,0,4,1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Brush.AccentSurface}"/>
        </Style>
        <Style Selector="TextBox.compact-search:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#72FFFFFF"/>
        </Style>
        <Style Selector="TextBox.compact-search:focus">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#B8FFFFFF"/>
        </Style>
        <Style Selector="TextBox.compact-search /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#46FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="TextBox.compact-search:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#72FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="TextBox.compact-search:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#B8FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="ComboBox.settings-input">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.Input}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="#FF15171A"/>
        </Style>
        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="#FF292C31"/>
        </Style>
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background" Value="#FF222831"/>
            <Setter Property="Foreground" Value="#E7F1FB"/>
        </Style>
        <Style Selector="Button.settings-action">
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.BorderStrong}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.settings-ghost">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
            <Setter Property="CornerRadius" Value="1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Opacity" Value="0.82"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.settings-card">
            <Setter Property="Background" Value="#FF15171A"/>
            <Setter Property="BorderBrush" Value="#52656A72"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="TextBlock.settings-kicker">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="Opacity" Value="0.48"/>
        </Style>
        <Style Selector="Button.profile-avatar">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="96"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="48"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.profile-avatar:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.82"/>
        </Style>
        <Style Selector="Slider.settings-simple">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.AccentStrong}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
        </Style>
        <Style Selector="Slider.settings-simple /template/ Thumb">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.AccentStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Slider.settings-simple:pointerover /template/ Thumb">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Background" Value="#FAF9EF"/>
        </Style>
        <Style Selector="ScrollViewer">
            <Setter Property="Padding" Value="0,0,14,0"></Setter>
        </Style>
    </UserControl.Styles>

    <Border BorderBrush="#52656A72" BorderThickness="0,0,0,1">
    <Grid RowDefinitions="62,*" Background="#FF1B1D20">
        <Border Grid.Row="0" Background="#FF141619"
                BorderBrush="{DynamicResource Theme.Brush.Divider}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="22,8">
                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Button x:Name="GeneralNavButton" Classes="settings-top-nav"
                                Tag="general" Click="OnSettingsNavigationClicked">
                            <Grid RowDefinitions="*,2">
                                <TextBlock x:Name="GeneralNavText"
                                           Text="General"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                                <Border x:Name="GeneralNavIndicator"
                                        Grid.Row="1"
                                        Height="2"
                                        Background="#FF78A9E6"/>
                            </Grid>
                        </Button>
                        <Button x:Name="ClassificationNavButton" Classes="settings-top-nav">
                            <Button.Content>
                                <Grid RowDefinitions="*,2">
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="ClassificationNavText"
                                                   Text="Classification"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <Path Width="8" Height="5"
                                              VerticalAlignment="Center"
                                              Data="M 1 1 L 4 4 L 7 1"
                                              Stroke="{DynamicResource Theme.Brush.TextSecondary}"
                                              StrokeThickness="1.3"
                                              StrokeLineCap="Round"/>
                                    </StackPanel>
                                    <Border x:Name="ClassificationNavIndicator"
                                            Grid.Row="1"
                                            Height="2"
                                            Background="#FF78A9E6"/>
                                </Grid>
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <Flyout.FlyoutPresenterTheme>
                                        <ControlTheme TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="CornerRadius" Value="0"/>
                                        </ControlTheme>
                                    </Flyout.FlyoutPresenterTheme>
                                    <Border Width="220"
                                            Padding="3"
                                            Background="#FF151619"
                                            BorderBrush="#8A656A72"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                        <StackPanel Spacing="0">
                                            <Button x:Name="ManageGenresMenuButton"
                                                    Classes="settings-classification-option"
                                                    Content="Manage Genres"
                                                    Tag="genres"
                                                    Click="OnSettingsNavigationClicked"/>
                                            <Button x:Name="TagsMenuButton"
                                                    Classes="settings-classification-option"
                                                    Content="Tags"
                                                    Tag="tags"
                                                    Click="OnSettingsNavigationClicked"/>
                                            <Button x:Name="StylesMenuButton"
                                                    Classes="settings-classification-option"
                                                    Content="Styles"
                                                    Tag="styles"
                                                    Click="OnSettingsNavigationClicked"/>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                </StackPanel>
                <Button Grid.Column="2"
                        Click="OnCloseClicked"
                        Width="34" Height="34" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Opacity="0.65" ToolTip.Tip="Close">
                    <Image Source="{SvgImage /Assets/close.svg}" Width="16" Height="16"/>
                </Button>
            </Grid>
        </Border>

        <!-- Settings content -->
        <Grid Grid.Row="1" RowDefinitions="Auto,1,*,Auto">
            <Grid x:Name="PageHeader" Grid.Row="0" ColumnDefinitions="*,320,Auto" ColumnSpacing="12" Margin="30,16,22,16">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitleText" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageDescriptionText" FontSize="11" Opacity="0.58" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid x:Name="GenreToolbar" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="10"
                      IsVisible="False" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Classes="compact-search"
                             Height="26" MinHeight="26" MaxHeight="26"
                             VerticalContentAlignment="Center"
                             Watermark="Search subgenres…"/>
                    <Button Grid.Column="1"
                            Classes="settings-action"
                            Height="28"
                            Content="Create subgenre"
                            Click="OnShowCreateSubgenreClicked"/>
                </Grid>
            </Grid>

            <Rectangle Grid.Row="1" Fill="#18808080"/>

            <Grid x:Name="GenreVocabularyPage" Grid.Row="2"
                  HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="200,1,*">
                    <ScrollViewer Padding="22,12,14,0" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="GenreGroupRows"/>
                    </ScrollViewer>
                    <Border Grid.Column="1" Width="1"
                            Background="#80656A72"/>
                    <ScrollViewer Grid.Column="2" Padding="20,12,16,0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalContentAlignment="Top">
                        <StackPanel x:Name="GenreVocabularyRows"
                                    MinWidth="300"
                                    MaxWidth="500"
                                    HorizontalAlignment="Stretch"
                                    Spacing="6"
                                    VerticalAlignment="Top"
                                    Margin="0,0,0,260"/>
                    </ScrollViewer>
                </Grid>

                <Border x:Name="CreateSubgenreOverlay"
                        ZIndex="10"
                        IsVisible="False"
                        Background="#99000000">
                    <Border MinWidth="260" MaxWidth="340" Margin="24"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Background="{DynamicResource Theme.Brush.Surface}"
                            BorderBrush="{DynamicResource Theme.Brush.BorderStrong}"
                            BorderThickness="1" CornerRadius="2" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="CreateSubgenreTitleText"
                                       Text="Create subgenre"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="MAIN GENRE" FontSize="9.5" FontWeight="SemiBold" Opacity="0.45"/>
                                <ComboBox x:Name="NewSubgenreMainGenreBox" Height="32"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="SUBGENRE NAME" FontSize="9.5" FontWeight="SemiBold" Opacity="0.45"/>
                            <TextBox x:Name="NewSubgenreBox" Classes="settings-input"
                                     Watermark="Enter subgenre name"
                                     KeyDown="OnNewSubgenreKeyDown"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Classes="settings-action" Content="Cancel"
                                        Click="OnCancelCreateSubgenreClicked"/>
                                <Button Classes="settings-action" Content="Create"
                                        Click="OnAddSubgenreClicked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

                <Border x:Name="EditSubgenreOverlay"
                        ZIndex="11"
                        IsVisible="False"
                        Background="#99000000">
                    <Border Width="430" MaxHeight="620" Margin="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource Theme.Brush.Surface}"
                            BorderBrush="{DynamicResource Theme.Brush.BorderStrong}"
                            BorderThickness="1" CornerRadius="2" Padding="18">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Edit subgenre" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="EditSubgenreMainGenreText" FontSize="10.5" Opacity="0.55"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="NAME" FontSize="9.5" FontWeight="SemiBold" Opacity="0.45"/>
                                        <TextBox x:Name="EditSubgenreNameBox" Classes="settings-input"/>
                                        <TextBlock x:Name="EditSubgenreNameText"
                                                   IsVisible="False" FontSize="12" FontWeight="SemiBold"
                                                   Margin="1,7,0,6"/>
                                    </StackPanel>
                                    <Border x:Name="EditSubgenreOriginBadge"
                                            HorizontalAlignment="Left"
                                            Background="#2638BDF8" BorderBrush="#6638BDF8"
                                            BorderThickness="1" CornerRadius="2" Padding="8,4">
                                        <TextBlock x:Name="EditSubgenreOriginText"
                                                   FontSize="9.5" FontWeight="SemiBold"/>
                                    </Border>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="DESCRIPTION" FontSize="9.5" FontWeight="SemiBold" Opacity="0.45"/>
                                        <TextBox x:Name="EditSubgenreDescriptionBox" Classes="settings-input"
                                                 Watermark="Add a concise description…"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 Height="80" VerticalContentAlignment="Top"/>
                                    </StackPanel>
                                    <CheckBox x:Name="EditSubgenrePreferredToggle" Content="Preferred genre"/>
                                    <CheckBox x:Name="EditSubgenreHiddenToggle"
                                              Content="Hidden throughout the application"/>
                                    <StackPanel x:Name="EditSubgenreReferencesPanel" Spacing="5"/>
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Classes="settings-action" Content="Cancel"
                                        Click="OnCancelEditSubgenreClicked"/>
                                <Button Classes="settings-action" Content="Save changes"
                                        Click="OnSaveSubgenreClicked"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>
            </Grid>

            <ScrollViewer x:Name="GeneralPage" Grid.Row="2" IsVisible="False" Margin="30,22,30,0"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12"
                            Margin="0,0,0,24"
                            Width="{Binding Bounds.Width, ElementName=GeneralPage}"
                            MaxWidth="800"
                            HorizontalAlignment="Center">
                    <Border x:Name="LinuxDependenciesPanel"
                            Classes="settings-card"
                            IsVisible="False">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="LINUX RUNTIME" Classes="settings-kicker"/>
                                    <TextBlock Text="System dependencies" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="The AppImage includes .NET. Playback and media tools are provided by the Linux system."
                                               FontSize="10.5" Opacity="0.58" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="settings-action" Content="Refresh"
                                        Click="OnRefreshLinuxDependenciesClicked" VerticalAlignment="Top"/>
                            </Grid>
                            <TextBlock x:Name="LinuxDependenciesText"
                                       FontFamily="Consolas,monospace" FontSize="11" LineHeight="19"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="settings-card">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Obsidian music library" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Mirror tracks and artwork to Data/Music inside the selected vault."
                                               FontSize="10.5" Opacity="0.58" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="ExportObsidianLibraryButton" Grid.Column="1"
                                        Classes="settings-action" Content="Export now"
                                        Click="OnExportObsidianLibraryClicked" VerticalAlignment="Top"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox x:Name="ObsidianVaultPathBox" Classes="settings-input"
                                         IsReadOnly="True" Watermark="Choose vault folder"/>
                                <Button Grid.Column="1" Classes="settings-action" Content="Choose vault"
                                        Click="OnChooseObsidianVaultClicked"/>
                            </Grid>
                            <TextBlock x:Name="ObsidianExportStatusText" IsVisible="False"
                                       FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="settings-card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Analysis server" FontSize="13" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBox x:Name="MusicAnalysisServerUrlBox" Classes="settings-input"
                                         Watermark="http://debian:5268"/>
                                <Button x:Name="TestAnalysisServerButton" Grid.Column="1"
                                        Classes="settings-action" Content="Test"
                                        Click="OnTestAnalysisServerClicked"/>
                                <Button Grid.Column="2" Classes="settings-action" Content="Save"
                                        Click="OnSaveAnalysisServerClicked"/>
                            </Grid>
                            <TextBlock x:Name="AnalysisServerStatusText" IsVisible="False"
                                       FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="settings-card">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="Discord presence" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <ToggleSwitch x:Name="DiscordPresenceToggle" Grid.Column="1"
                                              OnContent="On" OffContent="Off"
                                              Checked="OnDiscordPresenceEnabledChanged"
                                              Unchecked="OnDiscordPresenceEnabledChanged"/>
                            </Grid>
                            <TextBox x:Name="DiscordLargeImageTextBox" Classes="settings-input"
                                     MaxLength="128" Watermark="Optional Discord note"
                                     TextChanged="OnDiscordPresenceTextChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="settings-card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Song fade duration" FontSize="13" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="*,48" ColumnSpacing="10">
                                <Slider x:Name="SongFadeDurationSlider" Classes="settings-simple"
                                        Minimum="0" Maximum="30" TickFrequency="1"
                                        ValueChanged="OnSongFadeDurationChanged"
                                        DoubleTapped="OnSongFadeDurationDoubleTapped"/>
                                <TextBlock x:Name="SongFadeDurationValueText" Grid.Column="1"
                                           FontFamily="Consolas" FontSize="10.5" Opacity="0.72"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="settings-card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="YouTube browser session" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Use a signed-in browser profile for restricted videos."
                                       FontSize="10.5" Opacity="0.58" TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
                                <ComboBox x:Name="BrowserCookiesBrowserBox" Classes="settings-input"
                                          SelectionChanged="OnBrowserCookiesBrowserChanged">
                                    <ComboBoxItem Content="Firefox" Tag="firefox"/>
                                    <ComboBoxItem Content="Chrome" Tag="chrome"/>
                                    <ComboBoxItem Content="Edge" Tag="edge"/>
                                    <ComboBoxItem Content="Brave" Tag="brave"/>
                                </ComboBox>
                                <ToggleSwitch x:Name="BrowserCookiesToggle" Grid.Column="1"
                                              OnContent="On" OffContent="Off"
                                              Checked="OnBrowserCookiesSettingChanged"
                                              Unchecked="OnBrowserCookiesSettingChanged"/>
                            </Grid>
                            <TextBlock x:Name="BrowserCookiesWarningText" IsVisible="False"
                                       FontSize="10.5" Foreground="{DynamicResource Theme.Brush.Warning}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="settings-card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Application updates" FontSize="13" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="INSTALLED" Classes="settings-kicker"/>
                                    <TextBlock x:Name="InstalledVersionText" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AvailableVersionText" FontSize="10.5"
                                               Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"
                                            VerticalAlignment="Center">
                                    <Button x:Name="CheckForUpdatesButton" Classes="settings-action"
                                            Content="Check" Click="OnCheckForUpdatesClicked"/>
                                    <Button x:Name="DownloadUpdateButton" Classes="settings-action"
                                            Content="Download" IsVisible="False"
                                            Click="OnDownloadUpdateClicked"/>
                                    <Button x:Name="InstallUpdateButton" Classes="settings-action"
                                            Content="Restart &amp; install" IsVisible="False"
                                            Click="OnInstallUpdateClicked"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="UpdateStatusText" FontSize="10.5" Opacity="0.72"
                                       TextWrapping="Wrap"/>
                            <ProgressBar x:Name="UpdateProgressBar" IsVisible="False"
                                         Height="4" Minimum="0" Maximum="100"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="TagsPage" Grid.Row="2" IsVisible="False" RowDefinitions="Auto,*" Margin="30,22,30,0">
                <Grid Grid.RowSpan="2"
                      RowDefinitions="Auto,*"
                      MinWidth="280"
                      MaxWidth="380"
                      HorizontalAlignment="Stretch">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <TextBlock x:Name="TagVocabularyHintText"
                                   FontSize="10.5"
                                   Opacity="0.5"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="settings-action"
                                Content="Create tag"
                                Click="OnShowCreateTagClicked"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Padding="0" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TagRows"
                                    HorizontalAlignment="Stretch"
                                    Spacing="8"
                                    Margin="0,0,0,18"/>
                    </ScrollViewer>
                </Grid>

                <Border x:Name="CreateTagOverlay"
                        Grid.RowSpan="2"
                        ZIndex="10"
                        IsVisible="False"
                        Background="#99000000">
                    <Border MinWidth="260"
                            MaxWidth="340"
                            Margin="24"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Theme.Brush.Surface}"
                            BorderBrush="{DynamicResource Theme.Brush.BorderStrong}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Create tag" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBox x:Name="NewTagBox" Classes="settings-input"
                                     Watermark="Enter tag name"
                                     KeyDown="OnNewTagKeyDown"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Classes="settings-action" Content="Cancel"
                                        Click="OnCancelCreateTagClicked"/>
                                <Button Classes="settings-action" Content="Create"
                                        Click="OnAddTagClicked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <Grid x:Name="StylesPage" Grid.Row="2" IsVisible="False" RowDefinitions="Auto,*" Margin="30,22,30,0">
                <Grid Grid.RowSpan="2"
                      RowDefinitions="Auto,*"
                      MinWidth="280"
                      MaxWidth="380"
                      HorizontalAlignment="Stretch">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <TextBlock x:Name="StyleVocabularyHintText"
                                   FontSize="10.5"
                                   Opacity="0.5"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="settings-action"
                                Content="Create style"
                                Click="OnShowCreateStyleClicked"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Padding="0" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="StyleRows"
                                    HorizontalAlignment="Stretch"
                                    Spacing="8"
                                    Margin="0,0,0,18"/>
                    </ScrollViewer>
                </Grid>

                <Border x:Name="CreateStyleOverlay"
                        Grid.RowSpan="2"
                        ZIndex="10"
                        IsVisible="False"
                        Background="#99000000">
                    <Border MinWidth="260"
                            MaxWidth="340"
                            Margin="24"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Theme.Brush.Surface}"
                            BorderBrush="{DynamicResource Theme.Brush.BorderStrong}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Create style" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBox x:Name="NewStyleBox" Classes="settings-input"
                                     Watermark="Enter style name"
                                     KeyDown="OnNewStyleKeyDown"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Classes="settings-action" Content="Cancel"
                                        Click="OnCancelCreateStyleClicked"/>
                                <Button Classes="settings-action" Content="Create"
                                        Click="OnAddStyleClicked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <Grid x:Name="TagRulesPage" Grid.Row="2" IsVisible="False" RowDefinitions="Auto,*" Margin="30,22,30,0">
                <Grid Grid.Row="0" ColumnDefinitions="170,88,165,*,86,Auto" ColumnSpacing="10" Margin="0,0,0,14">
                    <ComboBox x:Name="TagRuleTagBox" Height="34"/>
                    <ComboBox x:Name="TagRuleMatchModeBox" Grid.Column="1" Height="34"/>
                    <ComboBox x:Name="TagRuleModelBox" Grid.Column="2" Height="34"
                              SelectionChanged="OnTagRuleModelSelectionChanged"/>
                    <ComboBox x:Name="TagRuleSignalBox" Grid.Column="3" Height="34"/>
                    <TextBox x:Name="TagRuleThresholdBox" Grid.Column="4" Height="34"
                             Text="0.30" Watermark="Score"/>
                    <Button Grid.Column="5" Content="Create rule" Click="OnAddTagRuleClicked"
                            Padding="12,5"/>
                </Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TagRuleRows" Spacing="5" Margin="0,0,0,18"/>
                </ScrollViewer>
            </Grid>

            <Border x:Name="SummaryBar" Grid.Row="3" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource Theme.Brush.Divider}" Padding="30,10,30,13">
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontSize="11" Opacity="0.65"/>
            </Border>
        </Grid>
    </Grid>
    </Border>
</UserControl>
