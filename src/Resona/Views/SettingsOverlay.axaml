<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Resona.Views"
             x:Class="Resona.Views.SettingsOverlay">

    <UserControl.Styles>
        <Style Selector="ToggleButton.settings-nav">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ToggleButton.settings-nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
        </Style>
        <Style Selector="ToggleButton.settings-nav:checked">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceSelected}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextStrong}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBox.settings-input">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.Input}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Small}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.compact-search">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#46FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="4,0,4,1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Brush.AccentSurface}"/>
        </Style>
        <Style Selector="TextBox.compact-search:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#72FFFFFF"/>
        </Style>
        <Style Selector="TextBox.compact-search:focus">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#B8FFFFFF"/>
        </Style>
        <Style Selector="TextBox.compact-search /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#46FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="TextBox.compact-search:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#72FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="TextBox.compact-search:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#B8FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="ComboBox.settings-input">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.Input}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Small}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.settings-action">
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.BorderStrong}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Small}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.settings-ghost">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Corner.Small}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Opacity" Value="0.82"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.profile-avatar">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="96"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="48"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.profile-avatar:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.82"/>
        </Style>
        <Style Selector="Slider.appearance-simple">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.AccentStrong}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
        </Style>
        <Style Selector="Slider.appearance-simple /template/ Thumb">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.AccentStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Slider.appearance-simple:pointerover /template/ Thumb">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Background" Value="#FAF9EF"/>
        </Style>
        <Style Selector="ScrollViewer">
            <Setter Property="Padding" Value="0,0,14,0"></Setter>
        </Style>
    </UserControl.Styles>

    <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="244,1,*" Background="#202020">
        <!-- Settings navigation -->
        <Border Grid.Column="0" Background="#171717" Padding="16,20,16,16">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,26,0,0" Padding="0"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel Spacing="6">
                            <ToggleButton x:Name="ProfileNavButton" Classes="settings-nav"
                                          Content="Account" Tag="profile"
                                          FontSize="13" FontWeight="SemiBold"
                                          Click="OnSettingsNavigationClicked"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{DynamicResource Theme.Brush.Divider}" Margin="4,14"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="EXPERIENCE" FontSize="10" FontWeight="SemiBold"
                                       Opacity="0.4" LetterSpacing="0.8" Margin="10,0,0,4"/>
                            <ToggleButton x:Name="AppearanceNavButton" Classes="settings-nav"
                                          Content="Appearance" Tag="appearance"
                                          Click="OnSettingsNavigationClicked"/>
                            <ToggleButton x:Name="DiscordNavButton" Classes="settings-nav"
                                          Content="Discord presence" Tag="discord"
                                          Click="OnSettingsNavigationClicked"/>
                            <ToggleButton x:Name="ServersNavButton" Classes="settings-nav"
                                          Content="Connections" Tag="servers"
                                          Click="OnSettingsNavigationClicked"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{DynamicResource Theme.Brush.Divider}" Margin="4,14"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="CLASSIFICATION" FontSize="10" FontWeight="SemiBold"
                                       Opacity="0.4" LetterSpacing="0.8" Margin="10,0,0,4"/>
                            <ToggleButton x:Name="GenreVocabularyNavButton" Classes="settings-nav"
                                          Content="Genres" Tag="genres"
                                          Click="OnSettingsNavigationClicked"/>
                            <ToggleButton x:Name="TagsNavButton" Classes="settings-nav"
                                          Content="Tags" Tag="tags"
                                          Click="OnSettingsNavigationClicked"/>
                            <ToggleButton x:Name="StylesNavButton" Classes="settings-nav"
                                          Content="Styles" Tag="styles"
                                          Click="OnSettingsNavigationClicked"/>
                            <ToggleButton x:Name="TagRulesNavButton" Classes="settings-nav"
                                          IsVisible="False"
                                          Content="Tag rules" Tag="tag_rules"
                                          Click="OnSettingsNavigationClicked"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{DynamicResource Theme.Brush.Divider}" Margin="4,14"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="LIBRARY" FontSize="10" FontWeight="SemiBold"
                                       Opacity="0.4" LetterSpacing="0.8" Margin="10,0,0,4"/>
                            <ToggleButton x:Name="HealthNavButton" Classes="settings-nav"
                                          Content="Health check" Tag="health"
                                          Click="OnSettingsNavigationClicked"/>
                            <ToggleButton x:Name="BackupNavButton" Classes="settings-nav"
                                          Content="Backup" Tag="backup"
                                          Click="OnSettingsNavigationClicked"/>
                            <ToggleButton x:Name="CloudSyncNavButton" Classes="settings-nav"
                                          Content="Cloud sync" Tag="cloud_sync"
                                          Click="OnSettingsNavigationClicked"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{DynamicResource Theme.Brush.Divider}" Margin="4,14"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="SYSTEM" FontSize="10" FontWeight="SemiBold"
                                       Opacity="0.4" LetterSpacing="0.8" Margin="10,0,0,4"/>
                            <ToggleButton x:Name="UpdatesNavButton" Classes="settings-nav"
                                          Content="Updates" Tag="updates"
                                          Click="OnSettingsNavigationClicked"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Rectangle Grid.Column="1" Fill="{DynamicResource Theme.Brush.Divider}"/>

        <!-- Settings content -->
        <Grid Grid.Column="2" RowDefinitions="Auto,1,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="30,20,22,16">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="PageTitleText" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageDescriptionText" FontSize="11" Opacity="0.58" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Click="OnCloseClicked"
                        Width="34"
                        Height="34"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Opacity="0.65"
                        VerticalAlignment="Top"
                        ToolTip.Tip="Close">
                    <Image Source="{SvgImage /Assets/close.svg}" Width="16" Height="16"/>
                </Button>
            </Grid>

            <Rectangle Grid.Row="1" Fill="#18808080"/>

            <Grid x:Name="GenreVocabularyPage" Grid.Row="2" RowDefinitions="Auto,*" Margin="30,22,30,0">
                <Grid Grid.Row="0" ColumnDefinitions="*,28" ColumnSpacing="8" Margin="0,0,0,14">
                    <TextBox x:Name="SearchBox" Classes="compact-search"
                             Height="24" MinHeight="24" MaxHeight="24"
                             VerticalContentAlignment="Center"
                             Watermark="Search genres…"/>
                    <Button Grid.Column="1"
                            Width="28" Height="28" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Create subgenre"
                            Click="OnShowCreateSubgenreClicked">
                        <Path Width="12" Height="12"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 6 0 L 6 12 M 0 6 L 12 6"
                              Stroke="{DynamicResource Theme.Brush.TextSecondary}"
                              StrokeThickness="1.5"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="118,13,*">
                    <ScrollViewer Padding="0" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="GenreGroupRows"/>
                    </ScrollViewer>
                    <Border Grid.Column="1" Width="1"
                            Background="{DynamicResource Theme.Brush.Divider}"
                            Margin="6,1"/>
                    <ScrollViewer Grid.Column="2" Padding="10,0,0,0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalContentAlignment="Top">
                        <UniformGrid x:Name="GenreVocabularyRows"
                                     Columns="2"
                                     ColumnSpacing="7"
                                     RowSpacing="7"
                                     VerticalAlignment="Top"
                                     Margin="0,0,0,18"/>
                    </ScrollViewer>
                </Grid>

                <Border x:Name="CreateSubgenreOverlay"
                        Grid.RowSpan="2"
                        ZIndex="10"
                        IsVisible="False"
                        Background="#99000000">
                    <Border MinWidth="260" MaxWidth="340" Margin="24"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Background="{DynamicResource Theme.Brush.Surface}"
                            BorderBrush="{DynamicResource Theme.Brush.BorderStrong}"
                            BorderThickness="1" CornerRadius="7" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="CreateSubgenreTitleText"
                                       Text="Create subgenre"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBox x:Name="NewSubgenreBox" Classes="settings-input"
                                     Watermark="Enter subgenre name"
                                     KeyDown="OnNewSubgenreKeyDown"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Classes="settings-action" Content="Cancel"
                                        Click="OnCancelCreateSubgenreClicked"/>
                                <Button Classes="settings-action" Content="Create"
                                        Click="OnAddSubgenreClicked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <ScrollViewer x:Name="ProfilePage" Grid.Row="2" IsVisible="False" Margin="30,22,30,0"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="22" Margin="0,0,0,24">
                    <StackPanel Spacing="5">
                        <TextBlock Text="ACCOUNT" FontSize="10" FontWeight="SemiBold" Opacity="0.42"/>
                        <TextBlock Text="Local account" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="This identity belongs to this Resona installation and authenticates its private cloud library."
                                   FontSize="11" Opacity="0.62" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="112,*" ColumnSpacing="22">
                        <Button x:Name="ProfileAvatarButton"
                                Classes="profile-avatar"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                ToolTip.Tip="Profile picture options">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <Flyout.FlyoutPresenterTheme>
                                        <ControlTheme TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="4"/>
                                            <Setter Property="Background" Value="#F21A1A1A"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.BorderStrong}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </ControlTheme>
                                    </Flyout.FlyoutPresenterTheme>
                                    <StackPanel Width="160" Spacing="2">
                                        <Button Background="Transparent" BorderThickness="0"
                                                HorizontalContentAlignment="Left"
                                                Padding="10,7"
                                                Click="OnChooseProfileImageClicked">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Image Source="{SvgImage /Assets/pencil-simple.svg}" Width="13" Height="13"/>
                                                <TextBlock Text="Change picture"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="RemoveProfileImageMenuButton"
                                                IsVisible="False"
                                                Background="Transparent" BorderThickness="0"
                                                HorizontalContentAlignment="Left"
                                                Padding="10,7"
                                                Click="OnRemoveProfileImageClicked">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Image Source="{SvgImage /Assets/trash.svg}" Width="13" Height="13"/>
                                                <TextBlock Text="Remove picture"
                                                           Foreground="{DynamicResource Theme.Brush.DangerText}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <Border Width="96" Height="96"
                                    CornerRadius="48" ClipToBounds="True"
                                    Background="{DynamicResource Theme.Brush.SurfaceSelected}"
                                    BorderBrush="{DynamicResource Theme.Brush.BorderStrong}" BorderThickness="1">
                                <Border CornerRadius="48" ClipToBounds="True"
                                        Background="Transparent">
                                    <Grid>
                                        <TextBlock x:Name="ProfileAvatarPlaceholderText"
                                                   Text="?" FontSize="31" FontWeight="SemiBold" Opacity="0.58"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image x:Name="ProfileAvatarImage" IsVisible="False" Stretch="UniformToFill"/>
                                        <Border Background="#10000000"/>
                                    </Grid>
                                </Border>
                            </Border>
                        </Button>

                        <StackPanel Grid.Column="1" Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="PUBLIC USER ID"
                                           FontSize="10" FontWeight="SemiBold" Opacity="0.42"/>
                                <Grid ColumnDefinitions="*,30" ColumnSpacing="5">
                                    <TextBlock x:Name="ProfileUserIdText"
                                               FontSize="10.5" FontFamily="Consolas"
                                               Opacity="0.72"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1"
                                            Width="30" Height="30" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            ToolTip.Tip="Copy user ID"
                                            Click="OnCopyProfileUserIdClicked">
                                        <Image Source="{SvgImage /Assets/copy.svg}" Width="13" Height="13"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="USERNAME" FontSize="10" FontWeight="SemiBold" Opacity="0.42"/>
                                <Grid ColumnDefinitions="*,24" ColumnSpacing="8">
                                    <TextBox x:Name="ProfileUsernameBox" Classes="settings-input"
                                             MaxLength="40" Watermark="Choose a display name"/>
                                    <Grid Grid.Column="1" Width="18" Height="18"
                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image x:Name="ProfileSaveLoadingIcon"
                                               IsVisible="False"
                                               Source="{SvgImage /Assets/reload.svg}"
                                               Width="14" Height="14"
                                               RenderTransformOrigin="50%,50%">
                                            <Image.RenderTransform>
                                                <RotateTransform/>
                                            </Image.RenderTransform>
                                        </Image>
                                        <Image x:Name="ProfileSaveCheckIcon"
                                               Source="{SvgImage /Assets/check-green.svg}"
                                               Width="14" Height="14"/>
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="ProfileStatusText"
                                           IsVisible="False" FontSize="10.5"
                                           Foreground="{DynamicResource Theme.Brush.DangerText}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource Theme.Brush.Divider}"/>

                    <StackPanel Spacing="18">
                        <Border x:Name="LinuxDependenciesPanel"
                                IsVisible="False"
                                Background="{DynamicResource Theme.Brush.SurfaceTranslucent}"
                                BorderBrush="{DynamicResource Theme.Brush.BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Linux dependencies"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="The AppImage includes .NET. Playback and media tools are provided by the Linux system."
                                                   FontSize="11"
                                                   Opacity="0.58"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="settings-action"
                                            Content="Refresh"
                                            Click="OnRefreshLinuxDependenciesClicked"
                                            VerticalAlignment="Top"/>
                                </Grid>
                                <TextBlock x:Name="LinuxDependenciesText"
                                           FontFamily="Consolas,monospace"
                                           FontSize="11"
                                           LineHeight="19"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="16" RowSpacing="9">
                            <StackPanel Spacing="4">
                                <TextBlock Text="YouTube browser session"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Uses a signed-in browser profile when YouTube requires authentication, for example for age-restricted videos."
                                           FontSize="11"
                                           Opacity="0.58"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9"
                                        VerticalAlignment="Center">
                                <ComboBox x:Name="BrowserCookiesBrowserBox"
                                          Classes="settings-input"
                                          Width="118"
                                          SelectionChanged="OnBrowserCookiesBrowserChanged">
                                    <ComboBoxItem Content="Firefox" Tag="firefox"/>
                                    <ComboBoxItem Content="Chrome" Tag="chrome"/>
                                    <ComboBoxItem Content="Edge" Tag="edge"/>
                                    <ComboBoxItem Content="Brave" Tag="brave"/>
                                </ComboBox>
                                <ToggleSwitch x:Name="BrowserCookiesToggle"
                                              OnContent="On"
                                              OffContent="Off"
                                              Checked="OnBrowserCookiesSettingChanged"
                                              Unchecked="OnBrowserCookiesSettingChanged"/>
                            </StackPanel>
                            <TextBlock x:Name="BrowserCookiesWarningText"
                                       Grid.Row="1" Grid.ColumnSpan="2"
                                       IsVisible="False"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Theme.Brush.Warning}"
                                       TextWrapping="Wrap"/>
                        </Grid>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ServersPage" Grid.Row="2" IsVisible="False" Margin="30,22,30,0"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="26" Margin="0,0,0,24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Cloud synchronization" FontSize="15" FontWeight="SemiBold"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="SERVER ADDRESS" FontSize="10" FontWeight="SemiBold" Opacity="0.42"/>
                            <Grid ColumnDefinitions="*,34" ColumnSpacing="8">
                                <TextBox x:Name="CloudServerUrlBox" Classes="settings-input"
                                         Watermark="https://cloud.example.com"/>
                                <Button Grid.Column="1"
                                        Width="34" Height="34" Padding="0"
                                        Background="Transparent" BorderThickness="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        ToolTip.Tip="Synchronize now"
                                        Click="OnSynchronizeCloudClicked">
                                    <Image Source="{SvgImage /Assets/cloud-arrow-down.svg}"
                                           Width="17" Height="17" Opacity="0.78"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="The latest metadata snapshot and missing audio files are synchronized for your Android library."
                                       FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Brush.Warning}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="CloudServerStatusText"
                                       IsVisible="False" FontSize="10.5" Opacity="0.68"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Height="1" Fill="{DynamicResource Theme.Brush.Divider}"/>

                    <StackPanel Spacing="12">
                        <TextBlock Text="Analysis server" FontSize="15" FontWeight="SemiBold"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="SERVER ADDRESS" FontSize="10" FontWeight="SemiBold" Opacity="0.42"/>
                            <TextBox x:Name="MusicAnalysisServerUrlBox"
                                     Classes="settings-input"
                                     Watermark="https://analyzer.example.com"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="API KEY" FontSize="10" FontWeight="SemiBold" Opacity="0.42"/>
                            <TextBox x:Name="MusicAnalysisApiKeyBox"
                                     Classes="settings-input"
                                     PasswordChar="●"
                                     Watermark="Optional access key"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9">
                            <TextBlock x:Name="AnalysisServerStatusText"
                                       IsVisible="False" FontSize="11"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Name="TestAnalysisServerButton"
                                    Grid.Column="1" Classes="settings-action"
                                    Content="Test connection"
                                    Click="OnTestAnalysisServerClicked"/>
                            <Button Grid.Column="2" Classes="settings-action"
                                    Content="Save"
                                    Click="OnSaveAnalysisServerClicked"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="HealthPage" Grid.Row="2" IsVisible="False" Margin="30,22,30,0"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20" Margin="0,0,0,24">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Database and media health" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Run read-only checks for structural damage, broken relationships, invalid workflow states, channel mappings, and audio files."
                                       FontSize="11" Opacity="0.62" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="RunHealthCheckButton"
                                Grid.Column="1"
                                Classes="settings-action"
                                Content="Run health check"
                                Click="OnRunHealthCheckClicked"
                                VerticalAlignment="Top"/>
                    </Grid>

                    <Border x:Name="HealthResultPanel"
                            IsVisible="False"
                            Background="{DynamicResource Theme.Brush.SurfaceTranslucent}"
                            BorderBrush="{DynamicResource Theme.Brush.BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="13,11">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                            <Border x:Name="HealthStatusDot" Width="8" Height="8" CornerRadius="4"
                                    Margin="0,4,0,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock x:Name="HealthSummaryText" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HealthCountsText" FontSize="10.5" Opacity="0.62" TextWrapping="Wrap"/>
                                <TextBlock x:Name="HealthLastRunText" FontSize="9.5" Opacity="0.42"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="HealthIssueRows" Spacing="8"/>
                    <TextBlock x:Name="HealthReadOnlyHint"
                               Text="This check never changes database rows or files."
                               FontSize="10.5" Opacity="0.46" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>


            <ScrollViewer x:Name="DiscordPage" Grid.Row="2" IsVisible="False" Margin="30,22,30,0"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="18" Margin="0,0,0,24">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Discord Rich Presence" FontSize="12.5" FontWeight="SemiBold"/>
                            <TextBlock Text="Show the current Resona track on your Discord profile."
                                       FontSize="10.5" Opacity="0.56" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="DiscordPresenceToggle"
                                      Grid.Column="1"
                                      OnContent="On"
                                      OffContent="Off"
                                      VerticalAlignment="Center"
                                      Checked="OnDiscordPresenceEnabledChanged"
                                      Unchecked="OnDiscordPresenceEnabledChanged"/>
                    </Grid>

                    <StackPanel Spacing="7">
                        <TextBlock Text="DISCORD NOTE" FontSize="10" FontWeight="SemiBold" Opacity="0.42"/>
                        <TextBlock Text="Shown below the channel name in your Discord activity."
                                   FontSize="10.5" Opacity="0.56" TextWrapping="Wrap"/>
                        <TextBox x:Name="DiscordLargeImageTextBox" Classes="settings-input"
                                 MaxLength="128" Watermark="Add a short note…"
                                 TextChanged="OnDiscordPresenceTextChanged"/>
                    </StackPanel>

                    <TextBlock Text="Saved automatically and reflected in Discord while music is playing."
                               FontSize="10.5" Opacity="0.54"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AppearancePage" Grid.Row="2" IsVisible="False" Margin="30,22,30,0"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20" Margin="0,0,0,24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="PLAYER" FontSize="10" FontWeight="SemiBold" Opacity="0.42"/>
                        <StackPanel x:Name="PlayerAppearanceRows" Spacing="16"/>
                    </StackPanel>

                    <Rectangle Height="1" Fill="{DynamicResource Theme.Brush.Divider}"/>

                    <StackPanel Spacing="12">
                        <TextBlock Text="TRACK LIST" FontSize="10" FontWeight="SemiBold" Opacity="0.42"/>
                        <StackPanel x:Name="TrackAppearanceRows" Spacing="16"/>
                        <StackPanel x:Name="TrackArtworkAppearanceRows" Spacing="16"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Changes are previewed immediately and saved automatically."
                                   FontSize="10.5" Opacity="0.54" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="settings-action"
                                Content="Reset to defaults" Click="OnResetAppearanceClicked"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="CloudSyncPage" Grid.Row="2" IsVisible="False" Margin="30,22,30,0"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="22" Margin="0,0,0,24">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Android cloud library" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="A full sync uploads the current metadata, filter presets, collections, and any missing audio files for your phone."
                                   FontSize="11" Opacity="0.62" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Padding="14,12" CornerRadius="8"
                                Background="{DynamicResource Theme.Brush.SurfaceHover}"
                                BorderBrush="{DynamicResource Theme.Brush.BorderSubtle}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="LOCAL AUDIO" FontSize="9.5" FontWeight="SemiBold" Opacity="0.46"/>
                                <TextBlock x:Name="CloudSyncTotalText" Text="—" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="14,12" CornerRadius="8"
                                Background="{DynamicResource Theme.Brush.SurfaceHover}"
                                BorderBrush="{DynamicResource Theme.Brush.BorderSubtle}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="IN CLOUD" FontSize="9.5" FontWeight="SemiBold" Opacity="0.46"/>
                                <TextBlock x:Name="CloudSyncUploadedText" Text="—" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="14,12" CornerRadius="8"
                                Background="{DynamicResource Theme.Brush.SurfaceHover}"
                                BorderBrush="{DynamicResource Theme.Brush.BorderSubtle}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="PENDING" FontSize="9.5" FontWeight="SemiBold" Opacity="0.46"/>
                                <TextBlock x:Name="CloudSyncPendingText" Text="—" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Theme.Brush.Accent}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Padding="14,12" CornerRadius="8"
                                Background="{DynamicResource Theme.Brush.SurfaceHover}"
                                BorderBrush="{DynamicResource Theme.Brush.BorderSubtle}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="PRESETS" FontSize="9.5" FontWeight="SemiBold" Opacity="0.46"/>
                                <TextBlock x:Name="CloudSyncPresetText" Text="—" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock x:Name="CloudSyncStateText" Text="Cloud synchronization has not run yet."
                                       FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="CloudSyncPercentText" Text=""
                                       FontSize="10.5" Opacity="0.58" VerticalAlignment="Center"/>
                        </Grid>
                        <ProgressBar x:Name="CloudSyncProgressBar" Minimum="0" Maximum="100" Height="4" Value="0"/>
                        <TextBlock x:Name="CloudSyncCompletedText" Text="" FontSize="10" Opacity="0.48"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SynchronizeLibraryButton"
                                Content="Full sync now"
                                Click="OnSynchronizeCloudClicked"
                                Classes="settings-action"/>
                        <Button Content="Copy Android server URL"
                                Click="OnCopyAndroidConnectionCodeClicked"
                                Classes="settings-action"/>
                    </StackPanel>
                    <TextBlock Text="Android only needs this URL. Access is limited by your home network or VPN."
                               FontSize="10" Opacity="0.48" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="BackupPage" Grid.Row="2" IsVisible="False" Margin="30,22,30,0"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="22">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Database backup" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="On startup, the app creates one database copy per day in each selected folder."
                                   FontSize="11" Opacity="0.62" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="5">
                            <TextBlock Text="BACKUP FOLDERS" FontSize="10" FontWeight="SemiBold" Opacity="0.42"/>
                            <TextBlock Text="Recommended: one folder on an external drive and one folder synced to cloud storage."
                                       FontSize="11" Opacity="0.56" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="settings-action"
                                Content="Add folder"
                                Click="OnAddBackupDirectoryClicked"
                                VerticalAlignment="Top"/>
                    </Grid>

                    <StackPanel x:Name="BackupDirectoryRows" Spacing="8"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="UpdatesPage" Grid.Row="2" IsVisible="False" Margin="30,22,30,0"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="22">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Application updates" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Resona checks the public GitHub releases for newer versions."
                                   FontSize="11" Opacity="0.62" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="3">
                                <TextBlock Text="INSTALLED VERSION" FontSize="10" FontWeight="SemiBold" Opacity="0.42"/>
                                <TextBlock x:Name="InstalledVersionText" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AvailableVersionText"
                                           FontSize="11"
                                           Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9"
                                        VerticalAlignment="Center">
                                <Button x:Name="CheckForUpdatesButton"
                                        Classes="settings-action"
                                        Content="Check for updates"
                                        Click="OnCheckForUpdatesClicked"/>
                                <Button x:Name="DownloadUpdateButton"
                                        Classes="settings-action"
                                        Content="Download update"
                                        IsVisible="False"
                                        Click="OnDownloadUpdateClicked"/>
                                <Button x:Name="InstallUpdateButton"
                                        Classes="settings-action"
                                        Content="Restart and install"
                                        IsVisible="False"
                                        Click="OnInstallUpdateClicked"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="UpdateStatusText"
                                   FontSize="11"
                                   Opacity="0.72"
                                   TextWrapping="Wrap"/>
                        <ProgressBar x:Name="UpdateProgressBar"
                                     IsVisible="False"
                                     Height="5"
                                     Minimum="0"
                                     Maximum="100"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="TagsPage" Grid.Row="2" IsVisible="False" RowDefinitions="Auto,*" Margin="30,22,30,0">
                <Grid Grid.RowSpan="2"
                      RowDefinitions="Auto,*"
                      MinWidth="280"
                      MaxWidth="380"
                      HorizontalAlignment="Stretch">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <TextBlock x:Name="TagVocabularyHintText"
                                   FontSize="10.5"
                                   Opacity="0.5"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="settings-action"
                                Content="Create tag"
                                Click="OnShowCreateTagClicked"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Padding="0" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TagRows"
                                    HorizontalAlignment="Stretch"
                                    Spacing="8"
                                    Margin="0,0,0,18"/>
                    </ScrollViewer>
                </Grid>

                <Border x:Name="CreateTagOverlay"
                        Grid.RowSpan="2"
                        ZIndex="10"
                        IsVisible="False"
                        Background="#99000000">
                    <Border MinWidth="260"
                            MaxWidth="340"
                            Margin="24"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Theme.Brush.Surface}"
                            BorderBrush="{DynamicResource Theme.Brush.BorderStrong}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Create tag" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBox x:Name="NewTagBox" Classes="settings-input"
                                     Watermark="Enter tag name"
                                     KeyDown="OnNewTagKeyDown"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Classes="settings-action" Content="Cancel"
                                        Click="OnCancelCreateTagClicked"/>
                                <Button Classes="settings-action" Content="Create"
                                        Click="OnAddTagClicked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <Grid x:Name="StylesPage" Grid.Row="2" IsVisible="False" RowDefinitions="Auto,*" Margin="30,22,30,0">
                <Grid Grid.RowSpan="2"
                      RowDefinitions="Auto,*"
                      MinWidth="280"
                      MaxWidth="380"
                      HorizontalAlignment="Stretch">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <TextBlock x:Name="StyleVocabularyHintText"
                                   FontSize="10.5"
                                   Opacity="0.5"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="settings-action"
                                Content="Create style"
                                Click="OnShowCreateStyleClicked"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Padding="0" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="StyleRows"
                                    HorizontalAlignment="Stretch"
                                    Spacing="8"
                                    Margin="0,0,0,18"/>
                    </ScrollViewer>
                </Grid>

                <Border x:Name="CreateStyleOverlay"
                        Grid.RowSpan="2"
                        ZIndex="10"
                        IsVisible="False"
                        Background="#99000000">
                    <Border MinWidth="260"
                            MaxWidth="340"
                            Margin="24"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Theme.Brush.Surface}"
                            BorderBrush="{DynamicResource Theme.Brush.BorderStrong}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Create style" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBox x:Name="NewStyleBox" Classes="settings-input"
                                     Watermark="Enter style name"
                                     KeyDown="OnNewStyleKeyDown"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Classes="settings-action" Content="Cancel"
                                        Click="OnCancelCreateStyleClicked"/>
                                <Button Classes="settings-action" Content="Create"
                                        Click="OnAddStyleClicked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <Grid x:Name="TagRulesPage" Grid.Row="2" IsVisible="False" RowDefinitions="Auto,*" Margin="30,22,30,0">
                <Grid Grid.Row="0" ColumnDefinitions="170,88,165,*,86,Auto" ColumnSpacing="10" Margin="0,0,0,14">
                    <ComboBox x:Name="TagRuleTagBox" Height="34"/>
                    <ComboBox x:Name="TagRuleMatchModeBox" Grid.Column="1" Height="34"/>
                    <ComboBox x:Name="TagRuleModelBox" Grid.Column="2" Height="34"
                              SelectionChanged="OnTagRuleModelSelectionChanged"/>
                    <ComboBox x:Name="TagRuleSignalBox" Grid.Column="3" Height="34"/>
                    <TextBox x:Name="TagRuleThresholdBox" Grid.Column="4" Height="34"
                             Text="0.30" Watermark="Score"/>
                    <Button Grid.Column="5" Content="Create rule" Click="OnAddTagRuleClicked"
                            Padding="12,5"/>
                </Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TagRuleRows" Spacing="5" Margin="0,0,0,18"/>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Theme.Brush.Divider}" Padding="30,10,30,13">
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontSize="11" Opacity="0.65"/>
            </Border>
        </Grid>
    </Grid>
    </Border>
</UserControl>
