<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Resona.Views"
             x:Class="Resona.Views.AddTrackOverlay">

    <Panel>

        <!-- Dim backdrop -->
        <Border Background="#70000000"/>

        <!-- Modal card: stretches to fill the panel with margin so footer is always in view -->
        <Border Margin="32,16,32,16"
                Width="600"
                MaxWidth="880" MinWidth="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="#F21F1D17"
                BorderThickness="1"
                BorderBrush="{DynamicResource Theme.Brush.BorderStrong}"
                CornerRadius="8"
                BoxShadow="0 8 40 4 #80000000">

            <Grid>
            <Grid RowDefinitions="Auto,1,*,1,Auto">

                <!-- Header -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="24,16,20,14">
                    <TextBlock Grid.Column="0"
                               Text="Add Track"
                               FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="✕"
                            Click="OnCloseClicked"
                            Padding="8,4" FontSize="13"
                            Opacity="0.55"
                            VerticalAlignment="Center" />
                </Grid>

                <!-- Header/body divider -->
                <Rectangle Grid.Row="1" Fill="#18808080" />

                <!-- Body (scrollable) -->
                <ScrollViewer x:Name="BodyScroll"
                              Grid.Row="2"
                              Padding="24,18,24,0"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="BodyContent"
                                Spacing="22"
                                Margin="0,0,0,20">

                        <StackPanel Spacing="7">
                            <TextBlock Text="YouTube URL"
                                       FontSize="13" FontWeight="SemiBold" />
                            <Grid>
                                <TextBox x:Name="UrlBox"
                                         Classes="theme-input"
                                         MinWidth="0"
                                         Padding="10,6,34,6"
                                         HorizontalAlignment="Stretch"
                                         TextWrapping="NoWrap"
                                         Watermark="https://www.youtube.com/watch?v=…" />
                                <TextBlock x:Name="UrlStateIcon"
                                           Text=""
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,11,0"
                                           IsHitTestVisible="False"/>
                            </Grid>
                            <TextBlock x:Name="UrlValidationText"
                                       Text=""
                                       FontSize="11"
                                       Opacity="0.78"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Rating"
                                       FontSize="13" FontWeight="SemiBold" />
                            <ComboBox x:Name="RatingBox" MinWidth="200" />
                        </StackPanel>
                        
                        <!-- Genres -->
                        <StackPanel Spacing="8" Margin="0,0,40,0" IsVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Genres"
                                           FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="optional — automatic analysis runs after download"
                                           FontSize="11" Opacity="0.5" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <WrapPanel x:Name="GenresPanel" Orientation="Horizontal" />
                            <Button x:Name="ShowMoreGenresBtn"
                                    Content="Show more genres"
                                    Classes="more-button"
                                    IsVisible="False"
                                    Click="OnShowMoreGenresClicked"
                                    HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Styles remain hidden while the first metadata version has no style data. -->
                        <Grid x:Name="StylesSection" IsVisible="False"
                              ColumnDefinitions="Auto,*" Margin="0,0,40,0">
                            <Border Grid.Column="0"
                                    Width="2" Margin="0,2,0,2"
                                    Background="#40808080" CornerRadius="1" />
                            <StackPanel Grid.Column="1" Spacing="8" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Styles"
                                               FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="optional"
                                               FontSize="11" Opacity="0.4"
                                               VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                </StackPanel>
                                <WrapPanel x:Name="StylesPanel" Orientation="Horizontal" />
                            </StackPanel>
                        </Grid>
                        
                        <Border Height="10" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Body/footer divider -->
                <Rectangle Grid.Row="3" Fill="#18808080" />

                <!-- Footer -->
                <Grid Grid.Row="4"
                      ColumnDefinitions="*,Auto"
                      Margin="24,10,24,16">
                    <TextBlock Grid.Column="0"
                               x:Name="StatusText"
                               Text="" TextWrapping="Wrap"
                               FontSize="12" Opacity="0.65"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DownloadBtn"
                                Content="Download"
                                Click="OnDownloadClicked"
                                IsEnabled="False"
                                Classes="accent" />
                        <Button x:Name="CloseBtn"
                                Content="Cancel"
                                Click="OnCloseClicked" />
                    </StackPanel>
                </Grid>

            </Grid>

            <Border x:Name="BusyLayer"
                    IsVisible="False"
                    Background="#B0181A1D"
                    CornerRadius="8">
                <Border Width="300"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Theme.Brush.Surface}"
                        BorderBrush="{DynamicResource Theme.Brush.BorderStrong}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22,18"
                        BoxShadow="0 8 28 2 #66000000">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="BusyTitleText"
                                   Text="Downloading track"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True"
                                     Height="5"
                                     Foreground="{DynamicResource Theme.Brush.Accent}"
                                     Background="#3B392F"/>
                        <TextBlock x:Name="BusyDetailText"
                                   Text=""
                                   FontSize="11"
                                   Opacity="0.62"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Border>
            </Grid>
        </Border>

    </Panel>

</UserControl>
