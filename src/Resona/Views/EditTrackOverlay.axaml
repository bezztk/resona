<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Resona.Views"
             x:Class="Resona.Views.EditTrackOverlay"
             Background="Transparent"
             ClipToBounds="True">

    <Panel>
        <Panel.Styles>
            <Style Selector="TextBlock">
                <Setter Property="FontFamily" Value="Inter"/>
            </Style>
            <Style Selector="Button">
                <Setter Property="FontFamily" Value="Inter"/>
                <Setter Property="CornerRadius" Value="2"/>
            </Style>
            <Style Selector="Border.edit-section">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#38656A72"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="12,8"/>
            </Style>
            <Style Selector="TextBox">
                <Setter Property="Background" Value="#E6171611"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.BorderStrong}"/>
                <Setter Property="FontFamily" Value="Inter"/>
            </Style>
            <Style Selector="TextBox.compact-search">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#46FFFFFF"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="4,0,4,1"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Brush.AccentSurface}"/>
            </Style>
            <Style Selector="TextBox.compact-search:pointerover">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#72FFFFFF"/>
            </Style>
            <Style Selector="TextBox.compact-search:focus">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#B8FFFFFF"/>
            </Style>
            <Style Selector="TextBox.compact-search /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#46FFFFFF"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="CornerRadius" Value="0"/>
            </Style>
            <Style Selector="TextBox.compact-search:pointerover /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#72FFFFFF"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>
            <Style Selector="TextBox.compact-search:focus /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#B8FFFFFF"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="CornerRadius" Value="0"/>
            </Style>
            <Style Selector="ComboBox">
                <Setter Property="Background" Value="#E6171611"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.BorderStrong}"/>
                <Setter Property="CornerRadius" Value="2"/>
                <Setter Property="FontFamily" Value="Inter"/>
            </Style>
            <Style Selector="ToggleButton.edit-chip">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#36FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="2"/>
            </Style>
            <Style Selector="ToggleButton.edit-chip /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#36FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="2"/>
            </Style>
            <Style Selector="ToggleButton.edit-chip:pointerover">
                <Setter Property="Background" Value="#0FFFFFFF"/>
                <Setter Property="BorderBrush" Value="#72FFFFFF"/>
            </Style>
            <Style Selector="ToggleButton.edit-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#0FFFFFFF"/>
                <Setter Property="BorderBrush" Value="#72FFFFFF"/>
            </Style>
            <Style Selector="ToggleButton.edit-chip:checked">
                <Setter Property="Background" Value="#263E6591"/>
                <Setter Property="BorderBrush" Value="#7A78A9E6"/>
            </Style>
            <Style Selector="ToggleButton.edit-chip:checked /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#263E6591"/>
                <Setter Property="BorderBrush" Value="#7A78A9E6"/>
            </Style>
            <Style Selector="ToggleButton.edit-chip:checked:pointerover">
                <Setter Property="Background" Value="#263E6591"/>
                <Setter Property="BorderBrush" Value="#7A78A9E6"/>
            </Style>
            <Style Selector="ToggleButton.edit-chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#263E6591"/>
                <Setter Property="BorderBrush" Value="#7A78A9E6"/>
            </Style>
            <Style Selector="Button.edit-choice:pointerover">
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent}"/>
            </Style>
        </Panel.Styles>

        <Border x:Name="EditorSurface"
                Background="#F2121212"
                BorderBrush="#14FFFFFF"
                BorderThickness="0,0,0,1"
                ZIndex="20">

            <Grid RowDefinitions="Auto,1,Auto,1,*">
                <Rectangle x:Name="EditorAtmosphereTint"
                           Grid.RowSpan="5"
                           Opacity="0.12"
                           IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="100%,100%" EndPoint="15%,10%">
                            <GradientStop Color="#D0545FAF" Offset="0"/>
                            <GradientStop Color="#90734FA8" Offset="0.48"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="26,15,22,12">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9">
                        <Image Source="{SvgImage /Assets/info.svg}" Width="18" Height="18" Opacity="0.76"/>
                        <TextBlock Text="Information" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="ReviewButton"
                                Click="OnReviewClicked"
                                ToolTip.Tip="Mark for review"
                                Width="34" Height="34" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                            <Grid Width="18" Height="18"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="1,0,0,0">
                                <Image x:Name="ReviewInactiveIcon"
                                       Source="{SvgImage /Assets/review.svg}"
                                       Width="17" Height="17"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                <Image x:Name="ReviewActiveIcon"
                                       Source="{SvgImage /Assets/review-active.svg}"
                                       Width="17" Height="17"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="False"/>
                            </Grid>
                        </Button>
                        <Button x:Name="AnalysisPolicyButton"
                                Click="OnAnalysisPolicyClicked"
                                ToolTip.Tip="Disable automatic analysis permanently"
                                Width="34" Height="34" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Opacity="0.45">
                            <Image Source="{SvgImage /Assets/pause.svg}" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="DeleteButton"
                                Click="OnDeleteClicked"
                                ToolTip.Tip="Delete track"
                                Width="34" Height="34" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Opacity="0.68">
                            <Image Source="{SvgImage /Assets/trash.svg}" Width="17" Height="17"/>
                        </Button>
                        <Button ToolTip.Tip="Close"
                                Click="OnCloseClicked"
                                Width="34" Height="34" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Opacity="0.65">
                            <Image Source="{SvgImage /Assets/close.svg}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Rectangle Grid.Row="1" Fill="#10808080" />

                <Border Grid.Row="2" Height="52" Background="Transparent">
                    <Grid ColumnDefinitions="*,Auto"
                          Margin="22,0"
                          Width="{Binding Bounds.Width, ElementName=EditorSurface}"
                          MaxWidth="800"
                          HorizontalAlignment="Center">
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <Button x:Name="ClearRatingButton"
                                    Height="32" Padding="10,0"
                                    Background="#0CFFFFFF"
                                    BorderBrush="#28FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="1"
                                    FontFamily="Inter"
                                    FontSize="9.5"
                                    Content="Remove Rating"
                                    Opacity="0.68"
                                    VerticalContentAlignment="Center"
                                    Click="OnClearRatingClicked"
                                    ToolTip.Tip="Remove rating"/>
                            <StackPanel x:Name="RatingOptionsPanel"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        Margin="0,0,14,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="RatingBandPanel"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Margin="0,0,8,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button x:Name="RatingBandLowButton"
                                    Width="28" Height="28" Padding="0"
                                    FontFamily="Inter"
                                    FontSize="17" FontWeight="Bold"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Click="OnRatingBandLowClicked"
                                    ToolTip.Tip="Low — near the lower edge of this rating">
                                <Border Width="8" Height="14"
                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        RenderTransformOrigin="50%,50%"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Border.OpacityMask>
                                        <ImageBrush Source="avares://Resona/Assets/rating-band-arrow.png" Stretch="Uniform"/>
                                    </Border.OpacityMask>
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="180"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Button>
                            <Button x:Name="RatingBandMidButton"
                                    Width="28" Height="28" Padding="0"
                                    FontFamily="Inter"
                                    FontSize="8" FontWeight="Bold"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Click="OnRatingBandMidClicked"
                                    ToolTip.Tip="Mid — solidly within this rating">
                                <Ellipse Width="6" Height="6"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="RatingBandHighButton"
                                    Width="28" Height="28" Padding="0"
                                    FontFamily="Inter"
                                    FontSize="17" FontWeight="Bold"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Click="OnRatingBandHighClicked"
                                    ToolTip.Tip="High — near the upper edge of this rating">
                                <Border Width="8" Height="14"
                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Border.OpacityMask>
                                        <ImageBrush Source="avares://Resona/Assets/rating-band-arrow.png" Stretch="Uniform"/>
                                    </Border.OpacityMask>
                                </Border>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Rectangle Grid.Row="3" Fill="#10808080" />

                <ScrollViewer x:Name="EditorContentScrollViewer"
                              Grid.Row="4"
                              Padding="0"
                              HorizontalContentAlignment="Center"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Width="{Binding Bounds.Width, ElementName=EditorContentScrollViewer}"
                          MaxWidth="800"
                          HorizontalAlignment="Center"
                          ClipToBounds="True">
                    <StackPanel Spacing="14" Margin="30,16,30,20">

                        <Border x:Name="CollectionMembershipSection"
                                Classes="edit-section"
                                IsVisible="False"
                                Padding="0">
                            <WrapPanel x:Name="CollectionMembershipPanel"
                                       Orientation="Horizontal"
                                       ItemHeight="28" />
                        </Border>

                        <Border Classes="edit-section">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Height="28">
                                    <TextBlock Text="Information" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TrackUsageText"
                                               Grid.Column="1"
                                               FontSize="10.5"
                                               Opacity="0.66"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <Grid ColumnDefinitions="104,*,30,30" Height="30" ColumnSpacing="6">
                                    <TextBlock Text="Rating" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RatingInformationText"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="3"
                                               Text="Unrated"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <Grid ColumnDefinitions="104,*,30,30" RowDefinitions="30,30,30,30,30,30,30,30,30" ColumnSpacing="6">
                                    <TextBlock Grid.Row="0" Text="Artist" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ArtistDisplayText" Grid.Row="0" Grid.Column="1" FontSize="11.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBox x:Name="ArtistBox" Grid.Row="0" Grid.Column="1" IsVisible="False"
                                             Classes="compact-search" Height="26" Margin="0,2" Watermark="Artist"
                                             VerticalContentAlignment="Center" Padding="4,2,4,0" />
                                    <Button x:Name="EditInformationButton"
                                            Grid.Row="0" Grid.Column="3"
                                            Click="OnEditInformationClicked"
                                            ToolTip.Tip="Edit track information"
                                            Width="28" Height="28" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            Opacity="0.78">
                                        <Image Source="{SvgImage /Assets/pencil-simple.svg}" Width="14" Height="14" />
                                    </Button>

                                    <TextBlock Grid.Row="1" Text="Title" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TitleDisplayText" Grid.Row="1" Grid.Column="1" FontSize="12.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBox x:Name="TitleBox" Grid.Row="1" Grid.Column="1" IsVisible="False"
                                             Classes="compact-search" Height="26" Margin="0,2" Watermark="Title"
                                             VerticalContentAlignment="Center" Padding="4,2,4,0" />

                                    <TextBlock Grid.Row="2" Text="Original title" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                                    <TextBlock x:Name="OriginalTitleDisplayText" Grid.Row="2" Grid.Column="1" FontSize="10.5"
                                               Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button x:Name="CopyOriginalTitleButton" Grid.Row="2" Grid.Column="3"
                                            Click="OnCopyOriginalTitleClicked" ToolTip.Tip="Copy original title"
                                            Width="26" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Opacity="0.76">
                                        <Image Source="{SvgImage /Assets/copy.svg}" Width="13" Height="13" />
                                    </Button>
                                    <TextBlock Grid.Row="3" Text="Channel" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ChannelDisplayText" Grid.Row="3" Grid.Column="1" FontSize="11.5"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="4" Text="YouTube URL" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                                    <TextBlock x:Name="YouTubeUrlDisplayText" Grid.Row="4" Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button x:Name="CopyYouTubeUrlButton" Grid.Row="4" Grid.Column="3"
                                            Click="OnCopyYouTubeUrlClicked" ToolTip.Tip="Copy YouTube URL"
                                            Width="26" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Opacity="0.76">
                                        <Image Source="{SvgImage /Assets/copy.svg}" Width="13" Height="13" />
                                    </Button>

                                    <TextBlock Grid.Row="5" Text="Channel URL" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ChannelUrlDisplayText" Grid.Row="5" Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button x:Name="CopyChannelUrlButton" Grid.Row="5" Grid.Column="3"
                                            Click="OnCopyChannelUrlClicked" ToolTip.Tip="Copy channel URL"
                                            Width="26" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Opacity="0.76">
                                        <Image Source="{SvgImage /Assets/copy.svg}" Width="13" Height="13" />
                                    </Button>

                                    <TextBlock Grid.Row="6" Text="Uploaded" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                                    <TextBlock x:Name="UploadedDisplayText" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3"
                                               FontSize="10.5" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="7" Text="YouTube activity" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                                    <TextBlock x:Name="YouTubeActivityDisplayText" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3"
                                               FontSize="10.5" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="8" Text="Metadata updated" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MetadataUpdatedDisplayText" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3"
                                               FontSize="10.5" Opacity="0.72" VerticalAlignment="Center" />
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource Theme.Brush.BorderSubtle}" Margin="0,3" />

                                <Grid x:Name="AudioAnalysisSection" RowDefinitions="Auto,Auto,Auto" RowSpacing="3" Margin="0,5,0,0">
                                    <Border x:Name="BpmMetricCard" Background="Transparent" Padding="0,4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Tempo" FontSize="10.5" FontWeight="SemiBold" />
                                                <TextBlock x:Name="BpmInsightText" FontSize="9.5" Opacity="0.56" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock x:Name="BpmText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="LoudnessMetricCard" Grid.Row="1" Background="Transparent" Padding="0,4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Loudness" FontSize="10.5" FontWeight="SemiBold" />
                                                <TextBlock x:Name="LoudnessInsightText" FontSize="9.5" Opacity="0.56" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock x:Name="IntegratedLoudnessText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="DynamicsMetricCard" Grid.Row="2" Background="Transparent" Padding="0,4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Dynamics" FontSize="10.5" FontWeight="SemiBold" />
                                                <TextBlock x:Name="DynamicsInsightText" FontSize="9.5" Opacity="0.56" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock x:Name="LoudnessRangeText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <StackPanel x:Name="EmotionalCharacterSection" IsVisible="False" Spacing="6" Margin="0,3,0,0">
                                    <TextBlock Text="Emotional character" FontSize="10.5" FontWeight="SemiBold" />
                                    <StackPanel x:Name="EmotionalCharacterResultsPanel" Spacing="5" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Rectangle Height="1"
                                   Fill="{DynamicResource Theme.Brush.BorderSubtle}"
                                   Margin="12,-2" />

                        <Border Classes="edit-section" BorderThickness="0">
                            <StackPanel Spacing="9">
                            <TextBlock Text="Classification" FontSize="13" FontWeight="SemiBold" />
                            <StackPanel x:Name="EditStylesSection" Spacing="6" Margin="0,3,0,5">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="7"
                                      Margin="0,4">
                                    <Border Width="14" Height="14" VerticalAlignment="Center">
                                        <Path Width="5" Height="9"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4.5 L 0 9"
                                              Stroke="{DynamicResource Theme.Brush.TextSecondary}"
                                              StrokeThickness="1" RenderTransformOrigin="50%,50%">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="90" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="Style" FontSize="11" Opacity="0.72"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel x:Name="EditStylesPanel"
                                            Spacing="7"
                                            Margin="22,0,0,2" />
                            </StackPanel>
                            <StackPanel Spacing="6" Margin="0,3,0,5">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="7"
                                      Margin="0,4">
                                    <Border Width="14" Height="14" VerticalAlignment="Center">
                                        <Path Width="5" Height="9"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4.5 L 0 9"
                                              Stroke="{DynamicResource Theme.Brush.TextSecondary}"
                                              StrokeThickness="1" RenderTransformOrigin="50%,50%">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="90" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="Tags" FontSize="11" Opacity="0.72"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel x:Name="TagsPanel" Spacing="9" Margin="22,0,0,2" />
                                <StackPanel x:Name="SuggestedTagsSection" Spacing="5" Margin="22,0,0,4" IsVisible="False">
                                    <TextBlock Text="Suggested tags" FontSize="11" Opacity="0.68" />
                                    <StackPanel x:Name="SuggestedTagsPanel" Spacing="4" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="ModelSelectedGenresSection" Spacing="6" Margin="0,0,0,5">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="7"
                                      Margin="0,4">
                                    <Border Width="14" Height="14" VerticalAlignment="Center">
                                        <Path Width="5" Height="9"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4.5 L 0 9"
                                              Stroke="{DynamicResource Theme.Brush.TextSecondary}"
                                              StrokeThickness="1" RenderTransformOrigin="50%,50%">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="90" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="Genres" FontSize="11" Opacity="0.72"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel x:Name="ModelSelectedGenresPanel" Spacing="6" Margin="22,0,0,2" />
                            </StackPanel>
                            <StackPanel x:Name="DetectedGenresSection" Spacing="6" Margin="0,3,0,5">
                                <Grid x:Name="DetectedGenresHeader"
                                      ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="7"
                                      Margin="0,4"
                                      Cursor="Hand"
                                      PointerPressed="OnDetectedGenresHeaderPressed">
                                    <Border Width="14" Height="14" VerticalAlignment="Center">
                                        <Path x:Name="DetectedGenresChevron"
                                              Width="5"
                                              Height="9"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4.5 L 0 9"
                                              Stroke="{DynamicResource Theme.Brush.TextSecondary}"
                                              StrokeThickness="1"
                                              RenderTransformOrigin="50%,50%">
                                            <Path.RenderTransform>
                                                <RotateTransform />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="More model detections"
                                               FontSize="11"
                                               Opacity="0.72"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="DetectedGenresCountText"
                                               Grid.Column="2"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                               Opacity="0.82"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel x:Name="DetectedGenresPanel"
                                            IsVisible="False"
                                            Spacing="4"
                                            Margin="22,0,0,2" />
                            </StackPanel>
                            <StackPanel x:Name="FrequentManualGenresSection" Spacing="6" Margin="0,0,0,5">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="7"
                                      Margin="0,4"
                                      Cursor="Hand"
                                      PointerPressed="OnFrequentManualGenresHeaderPressed">
                                    <Border Width="14" Height="14" VerticalAlignment="Center">
                                        <Path x:Name="FrequentManualGenresChevron"
                                              Width="5"
                                              Height="9"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4.5 L 0 9"
                                              Stroke="{DynamicResource Theme.Brush.TextSecondary}"
                                              StrokeThickness="1"
                                              RenderTransformOrigin="50%,50%">
                                            <Path.RenderTransform>
                                                <RotateTransform />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="Often added manually"
                                               FontSize="11"
                                               Opacity="0.72"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="FrequentManualGenresCountText"
                                               Grid.Column="2"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                               Opacity="0.82"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel x:Name="FrequentManualGenresPanel"
                                            IsVisible="False"
                                            Spacing="4"
                                            Margin="22,0,0,2" />
                            </StackPanel>
                            <StackPanel x:Name="AddModelGenreSection" Spacing="6" Margin="0,0,0,5">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="7"
                                      Margin="0,4"
                                      Cursor="Hand"
                                      PointerPressed="OnAllGenresHeaderPressed">
                                    <Border Width="14" Height="14" VerticalAlignment="Center">
                                        <Path x:Name="AllGenresChevron"
                                              Width="5"
                                              Height="9"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4.5 L 0 9"
                                              Stroke="{DynamicResource Theme.Brush.TextSecondary}"
                                              StrokeThickness="1"
                                              RenderTransformOrigin="50%,50%">
                                            <Path.RenderTransform>
                                                <RotateTransform />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="All genres"
                                               FontSize="11"
                                               Opacity="0.72"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="AllGenresCountText"
                                               Grid.Column="2"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                               Opacity="0.82"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel x:Name="AllGenresPanel"
                                            IsVisible="False"
                                            Spacing="10"
                                            Margin="17,0,0,3">
                                    <TextBox x:Name="ModelGenreSearchBox"
                                             Classes="compact-search"
                                             Width="280"
                                             MaxWidth="300"
                                             Height="24"
                                             MinHeight="24"
                                             MaxHeight="24"
                                             HorizontalAlignment="Right"
                                             VerticalContentAlignment="Center"
                                             Watermark="Search genres…"
                                             TextChanged="OnModelGenreSearchChanged" />
                                    <Grid ColumnDefinitions="118,13,*">
                                        <StackPanel x:Name="ModelGenreGroupsPanel" />
                                        <Border Grid.Column="1"
                                                Width="1"
                                                Background="{DynamicResource Theme.Brush.Divider}"
                                                Margin="6,1" />
                                        <ScrollViewer x:Name="ModelGenreChoicesScroll"
                                                      Grid.Column="2"
                                                      Padding="10,0,0,0"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <UniformGrid x:Name="ModelGenreChoicesPanel"
                                                         Columns="2"
                                                         ColumnSpacing="7"
                                                         RowSpacing="7"
                                                         Margin="0,0,0,8" />
                                        </ScrollViewer>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="7" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="7"
                                      Margin="0,4"
                                      Cursor="Hand"
                                      PointerPressed="OnLanguagesHeaderPressed">
                                    <Border Width="14" Height="14" VerticalAlignment="Center">
                                        <Path x:Name="LanguagesChevron"
                                              Width="5"
                                              Height="9"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4.5 L 0 9"
                                              Stroke="{DynamicResource Theme.Brush.TextSecondary}"
                                              StrokeThickness="1"
                                              RenderTransformOrigin="50%,50%">
                                            <Path.RenderTransform>
                                                <RotateTransform />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="Language"
                                               FontSize="11"
                                               Opacity="0.72"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="LanguagesSummaryText"
                                               Grid.Column="2"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel x:Name="LanguagesPanel" IsVisible="False" Spacing="7" Margin="21,0,0,0" />
                            </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Height="50" />
                    </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border x:Name="AnalysisBusyLayer"
                        Grid.RowSpan="5"
                        IsVisible="False"
                        Background="#C0181A1D">
                    <Border Width="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#242119" BorderBrush="#71805A" BorderThickness="1" CornerRadius="2" Padding="24,20">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Analyzing track…" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock x:Name="AnalysisElapsedText" Grid.Column="1" Text="0:00" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                            </Grid>
                            <ProgressBar IsIndeterminate="True" Height="5" Foreground="{DynamicResource Theme.Brush.Accent}" Background="#3B392F"/>
                            <TextBlock x:Name="AnalysisEstimateText" FontSize="10.5" Opacity="0.62" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="Elapsed time" FontSize="10" Opacity="0.48" HorizontalAlignment="Right" Margin="0,-7,0,0"/>
                        </StackPanel>
                    </Border>
                </Border>

            </Grid>
        </Border>

    </Panel>

</UserControl>
