<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Resona.Companion.Views.MainView"
             TopLevel.AutoSafeAreaPadding="False">

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Mobile.Brush.TextPrimary}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource Mobile.Brush.Input}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Brush.BorderStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Mobile.Brush.TextPrimary}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Mobile.Corner.Control}"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Mobile.Brush.Input}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Brush.BorderStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Mobile.Brush.TextPrimary}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Mobile.Corner.Control}"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource Mobile.Brush.SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Brush.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource Mobile.Brush.TextPrimary}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Mobile.Corner.Control}"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource Mobile.Brush.SurfaceHover}"/>
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.toolbarIcon">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primaryPlayer">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="{DynamicResource Mobile.Brush.Accent}"/>
            <Setter Property="Background" Value="{DynamicResource Mobile.Brush.Divider}"/>
        </Style>
        <Style Selector="Slider:horizontal /template/ Thumb">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="MinHeight" Value="8"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Mobile.Brush.TextPrimary}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto"
          Background="{DynamicResource Mobile.Brush.Background}">

        <Image x:Name="AppArtworkPreviousBackground"
               Grid.RowSpan="3"
               Stretch="UniformToFill"
               IsHitTestVisible="False"
               IsVisible="False"
               Opacity="0">
            <Image.Effect>
                <BlurEffect Radius="18"/>
            </Image.Effect>
            <Image.RenderTransform>
                <ScaleTransform ScaleX="1.12" ScaleY="1.12"/>
            </Image.RenderTransform>
        </Image>
        <Image x:Name="AppArtworkBackground"
               Grid.RowSpan="3"
               Stretch="UniformToFill"
               IsHitTestVisible="False"
               IsVisible="False"
               Opacity="0">
            <Image.Effect>
                <BlurEffect Radius="16"/>
            </Image.Effect>
            <Image.RenderTransform>
                <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
            </Image.RenderTransform>
        </Image>
        <Border Grid.RowSpan="3" IsHitTestVisible="False" Background="#B0101012"/>
        <Border x:Name="AppAtmosphereTint" Grid.RowSpan="3" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#382E4E86" Offset="0"/>
                    <GradientStop Color="#00141414" Offset="0.48"/>
                    <GradientStop Color="#302E1F5E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border x:Name="HeaderBar"
                Grid.Row="0"
                Background="#24141414"
                BorderBrush="{DynamicResource Mobile.Brush.BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="14,6,12,6">
            <StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5">
                    <Border Width="3" Height="29"
                            CornerRadius="2"
                            Background="{DynamicResource Mobile.Brush.AccentStrong}"
                            VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1"
                                Spacing="1"
                                VerticalAlignment="Center"
                                Tapped="OnChooseLibraryFolderClicked">
                        <TextBlock x:Name="LibraryContextTitleText" Text="LIBRARY"
                                   FontFamily="Consolas, monospace"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.1"/>
                        <TextBlock x:Name="PlaylistSummaryText"
                                   FontFamily="Consolas, monospace"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource Mobile.Brush.TextMuted}"
                                   Opacity="0.78"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="SearchButton" Classes="toolbarIcon"
                            Click="OnToggleSearchClicked" Opacity="0.72" ToolTip.Tip="Search">
                        <Image Source="{SvgImage /Assets/search.svg}" Width="17" Height="17"/>
                    </Button>
                    <Button Grid.Column="3" x:Name="FilterButton" Classes="toolbarIcon"
                            Click="OnToggleFiltersClicked" ToolTip.Tip="Filters">
                        <Image Source="{SvgImage /Assets/filter.svg}" Width="18" Height="18"/>
                    </Button>
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1" Grid.ColumnSpan="2"
                             ZIndex="4"
                             IsVisible="False"
                             Watermark="Search tracks"
                             Height="38"
                             Margin="0,0,1,0"
                             VerticalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <Panel Grid.Row="1">
            <Rectangle Fill="#24141414" IsHitTestVisible="False"/>
            <ListBox x:Name="TrackList"
                     Margin="8,3"
                     Background="Transparent"
                     BorderThickness="0"
                     Tapped="OnTrackTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid RowDefinitions="Auto,9">
                            <Border Background="{Binding CurrentBackground}"
                                    BorderBrush="{Binding CurrentAccent}"
                                    BorderThickness="{Binding CurrentBorderThickness}"
                                    CornerRadius="0,7,7,0"
                                    Padding="8,6">
                                <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="7">
                                    <Border Width="40" Height="40"
                                            CornerRadius="2"
                                            ClipToBounds="True"
                                            Background="{DynamicResource Mobile.Brush.SurfaceRaised}"
                                            VerticalAlignment="Center">
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="3"
                                          VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontFamily="avares://Resona.Companion/Assets/Fonts#Noto Serif CJK JP"
                                                   FontSize="14.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Mobile.Brush.TextStrong}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Subgenres}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}"
                                                               Foreground="{Binding Foreground}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Margin="0,0,5,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DurationText}"
                                               Margin="5,0,1,0"
                                               FontFamily="Consolas, monospace"
                                               FontSize="10.5"
                                               Foreground="#8AB8F2"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1"
                                    Height="1"
                                    Margin="10,4"
                                    Background="{DynamicResource Mobile.Brush.Divider}"
                                    Opacity="0.24"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="StatusText"
                       ZIndex="24"
                       IsVisible="False"
                       Margin="14,8"
                       Padding="9,5"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       MaxWidth="760"
                       Background="#E0222225"
                       Foreground="{DynamicResource Mobile.Brush.Warning}"
                       FontSize="10.5"
                       TextWrapping="Wrap"/>

            <Border x:Name="FilterDrawer"
                    IsVisible="False"
                    HorizontalAlignment="Right"
                    Width="340"
                    MaxWidth="340"
                    Background="{DynamicResource Mobile.Brush.Navigation}"
                    BorderBrush="{DynamicResource Mobile.Brush.BorderStrong}"
                    BorderThickness="1,0,0,0"
                    BoxShadow="-12 0 34 0 #88000000">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="16,14,10,12" Height="34">
                        <TextBlock Text="FILTERS" FontSize="14" FontWeight="SemiBold" LetterSpacing="0.8"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Click="OnToggleFiltersClicked" ToolTip.Tip="Close"
                                Width="34" Height="32" Padding="0" Background="Transparent" BorderThickness="0">
                            <Path Data="M5 5 L19 19 M19 5 L5 19"
                                  Width="14" Height="14" Stretch="Uniform" Fill="Transparent"
                                  Stroke="{DynamicResource Mobile.Brush.TextPrimary}" StrokeThickness="1.8"
                                  StrokeLineCap="Round"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Padding="16,8,16,22">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="PRESETS" FontSize="9.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Mobile.Brush.TextMuted}" LetterSpacing="0.8"/>
                                <StackPanel x:Name="PresetRows" Spacing="6"/>
                            </StackPanel>
                            <Rectangle Height="1" Fill="{DynamicResource Mobile.Brush.Divider}"/>
                            <StackPanel Spacing="6">
                                <TextBlock Text="COLLECTIONS" FontSize="9.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Mobile.Brush.TextMuted}" LetterSpacing="0.8"/>
                                <StackPanel x:Name="CollectionRows" Spacing="6"/>
                            </StackPanel>
                            <Rectangle Height="1" Fill="{DynamicResource Mobile.Brush.Divider}"/>
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,140" ColumnSpacing="8">
                                    <TextBlock Text="RATING" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Mobile.Brush.TextMuted}"
                                               LetterSpacing="0.8" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Height="30"
                                            Background="{DynamicResource Mobile.Brush.Surface}"
                                            BorderBrush="{DynamicResource Mobile.Brush.BorderStrong}"
                                            BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                        <Grid ColumnDefinitions="69,69">
                                            <Border x:Name="RatingModeIndicator" Grid.ColumnSpan="2" Width="69"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource Mobile.Brush.AccentSurface}"
                                                    CornerRadius="5,0,0,5" IsHitTestVisible="False">
                                                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                                            </Border>
                                            <Border Grid.Column="0" Background="Transparent" PointerPressed="OnAllRatingsPressed">
                                                <TextBlock x:Name="AllRatingsText" Text="All" FontSize="10" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="Transparent" PointerPressed="OnManualRatingsPressed">
                                                <TextBlock x:Name="ManualRatingsText" Text="Manual" FontSize="10" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <StackPanel x:Name="RatingButtonsPanel" Spacing="5" IsVisible="False"/>
                            </StackPanel>
                            <Border Height="132"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border x:Name="Toast"
                    IsVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="18"
                    Background="#F0222225"
                    BorderBrush="{DynamicResource Mobile.Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14,9">
                <TextBlock x:Name="ToastText" FontSize="11.5" FontWeight="SemiBold"/>
            </Border>
        </Panel>

        <Border Grid.Row="2"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="0"
                ClipToBounds="False"
                BoxShadow="0 -14 36 6 #A0000000">
            <Border ClipToBounds="True"
                    BoxShadow="inset 0 8 16 -12 #50000000">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#E012141A" Offset="0"/>
                        <GradientStop Color="#D0141924" Offset="0.56"/>
                        <GradientStop Color="#E00E1015" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid x:Name="PlayerContent"
                      RowDefinitions="Auto,Auto,Auto" RowSpacing="1" Margin="12,5,12,13">
                    <Grid ColumnDefinitions="42,*" ColumnSpacing="8">
                        <Border Width="38" Height="38" CornerRadius="2" ClipToBounds="True"
                                Padding="0,0,2,0"
                                Background="{DynamicResource Mobile.Brush.Surface}"
                                BorderBrush="{DynamicResource Mobile.Brush.Border}"
                                BorderThickness="1">
                            <Image x:Name="NowPlayingCover" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="NowPlayingText"
                                       FontFamily="avares://Resona.Companion/Assets/Fonts#Noto Serif CJK JP"
                                       Text="Nothing playing"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Slider x:Name="ProgressSlider" Minimum="0" Maximum="100" Value="0"/>
                        <TextBlock x:Name="TimeText" Grid.Column="1"
                                   Text="00:00 / 00:00" FontSize="9.5"
                                   FontFamily="Consolas, monospace"
                                   Foreground="{DynamicResource Mobile.Brush.TextMuted}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="1">
                    <Button x:Name="PreviousButton" Grid.Column="0" Classes="icon"
                            Width="38" Height="34"
                            Click="OnPreviousClicked" ToolTip.Tip="Previous">
                        <Image Source="{SvgImage /Assets/skip-back.svg}" Width="21" Height="21"/>
                    </Button>
                    <Button x:Name="PlayPauseButton" Grid.Column="1" Classes="primaryPlayer"
                            Width="38" Height="34"
                            Click="OnPlayPauseClicked" ToolTip.Tip="Play / Pause">
                        <Grid Width="21" Height="21">
                            <Image x:Name="PlayIcon" Source="{SvgImage /Assets/play.svg}"/>
                            <Image x:Name="PauseIcon" Source="{SvgImage /Assets/pause.svg}" IsVisible="False"/>
                        </Grid>
                    </Button>
                    <Button x:Name="NextButton" Grid.Column="2" Classes="icon"
                            Width="38" Height="34"
                            Click="OnNextClicked" ToolTip.Tip="Next">
                        <Image Source="{SvgImage /Assets/skip-forward.svg}" Width="21" Height="21"/>
                    </Button>
                    <Button x:Name="ShuffleButton" Grid.Column="4" Classes="icon"
                            Width="38" Height="34"
                            Opacity="0.45" Click="OnShuffleClicked" ToolTip.Tip="Shuffle">
                        <Image Source="{SvgImage /Assets/shuffle.svg}" Width="20" Height="20"/>
                    </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>

    </Grid>
</UserControl>
